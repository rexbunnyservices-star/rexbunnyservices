        <p class="text-sm text-dark-300">
          Engineering your brand into the AI search results that matter.
        </p>
      </div>
      <div>
        <h4 class="mb-4 text-sm font-semibold uppercase tracking-wider text-dark-400">Services</h4>
        <ul class="space-y-2 text-sm text-dark-300">
          <li><a href="/services/web-development" class="hover:text-brand-400">Web Development</a></li>
          <li><a href="/services/seo" class="hover:text-brand-400">Technical SEO</a></li>
          <li><a href="/services/ai-search-optimization" class="hover:text-brand-400">AI Search Optimization</a></li>
        </ul>
      </div>
      <div>
        <h4 class="mb-4 text-sm font-semibold uppercase tracking-wider text-dark-400">Resources</h4>
