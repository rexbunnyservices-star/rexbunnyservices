---
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-1">
        <a href="/" class="mb-4 flex items-center gap-2">
          <img
            src="/images/logo.png"
            alt="RexBunny Services"
            width="400"
            height="503"
            class="h-10 w-auto"
            decoding="async"
          />
        </a>
        <p class="text-sm text-gray-500 leading-relaxed">
          A growth engineering practice making your brand visible in every search — Google, AI, and
          voice — then connecting that visibility to pipeline. AI search, sites, lead engines,
          campaigns, and dashboards.
        </p>
      </div>
      <div>
        <h2 class="mb-5 text-xs font-bold uppercase tracking-[2px] text-gray-500">Services</h2>
        <ul class="space-y-3 text-sm text-gray-600">
          <li>
            <a href="/services/seo" class="hover:text-brand-600 transition-colors"
              >AI Search Optimization</a
            >
          </li>
          <li>
            <a href="/services/web-development" class="hover:text-brand-600 transition-colors"
              >Website Generation</a
            >
          </li>
          <li>
            <a href="/services/lead-generation" class="hover:text-brand-600 transition-colors"
              >Lead Generation</a
            >
          </li>
          <li>
            <a href="/services/ad-campaigns" class="hover:text-brand-600 transition-colors"
              >Ad Campaigns</a
            >
          </li>
          <li>
            <a href="/services/ecommerce-dashboards" class="hover:text-brand-600 transition-colors"
              >Shopping Dashboards</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h2 class="mb-5 text-xs font-bold uppercase tracking-[2px] text-gray-500">Resources</h2>
        <ul class="space-y-3 text-sm text-gray-600">
          <li><a href="/pricing" class="hover:text-brand-600 transition-colors">Pricing</a></li>
          <li>
            <a href="/lead-engine" class="hover:text-brand-600 transition-colors">Free AI Audit</a>
          </li>
          <li><a href="/blog" class="hover:text-brand-600 transition-colors">Blog</a></li>
          <li>
            <a href="/portfolio" class="hover:text-brand-600 transition-colors">Case Studies</a>
          </li>
          <li>
            <a href="/geo-checklist" class="hover:text-brand-600 transition-colors">GEO Checklist</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h2 class="mb-5 text-xs font-bold uppercase tracking-[2px] text-gray-500">Company</h2>
        <ul class="space-y-3 text-sm text-gray-600">
          <li><a href="/about" class="hover:text-brand-600 transition-colors">About</a></li>
          <li><a href="/contact" class="hover:text-brand-600 transition-colors">Contact</a></li>
          <li><a href="/privacy" class="hover:text-brand-600 transition-colors">Privacy</a></li>
          <li><a href="/terms" class="hover:text-brand-600 transition-colors">Terms</a></li>
        </ul>
      </div>
    </div>
    <div
      class="mt-12 flex flex-col items-center gap-4 border-t border-gray-200 pt-8 sm:flex-row sm:justify-between"
    >
      <div class="flex items-center gap-2 text-xs text-gray-500">
        &copy; {year} RexBunny Services. All rights reserved.
      </div>
      <div class="flex gap-4 text-xs text-gray-500">
        <a href="/privacy" class="hover:text-gray-600">Privacy</a>
        <a href="/terms" class="hover:text-gray-600">Terms</a>
      </div>
    </div>
  </div>
</footer>
