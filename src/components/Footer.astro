---
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-1">
        <a href="/" class="mb-4 flex items-center gap-2">
          <img src="/images/logo.png" alt="RexBunny Services" class="h-10 w-auto" loading="lazy" decoding="async" />
        </a>
        <p class="text-sm text-gray-500 leading-relaxed">
          A marketing agency making your brand visible in every search — Google, AI, and voice. We engineer your presence across SEO, GEO, and AEO.
        </p>
      </div>
      <div>
        <h2 class="mb-5 text-xs font-bold uppercase tracking-[2px] text-gray-500">Services</h2>
        <ul class="space-y-3 text-sm text-gray-600">
          <li><a href="/services/seo" class="hover:text-brand-600 transition-colors">SEO (Traditional Search)</a></li>
          <li><a href="/services/ai-search-optimization" class="hover:text-brand-600 transition-colors">GEO (AI Search)</a></li>
          <li><a href="/services/aeo" class="hover:text-brand-600 transition-colors">AEO (Answer Engine)</a></li>
          <li><a href="/services/web-development" class="hover:text-brand-600 transition-colors">Web Development</a></li>
          <li><a href="/services/ai-visual" class="hover:text-brand-600 transition-colors">AI Visual Services</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mb-5 text-xs font-bold uppercase tracking-[2px] text-gray-500">Resources</h2>
        <ul class="space-y-3 text-sm text-gray-600">
          <li><a href="/pricing" class="hover:text-brand-600 transition-colors">Pricing</a></li>
          <li><a href="/lead-engine" class="hover:text-brand-600 transition-colors">Free AI Audit</a></li>
          <li><a href="/blog" class="hover:text-brand-600 transition-colors">Blog</a></li>
          <li><a href="/portfolio" class="hover:text-brand-600 transition-colors">Case Studies</a></li>
          <li><a href="/ai-search-statistics" class="hover:text-brand-600 transition-colors">AI Search Statistics</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mb-5 text-xs font-bold uppercase tracking-[2px] text-gray-500">Company</h2>
        <ul class="space-y-3 text-sm text-gray-600">
          <li><a href="/about" class="hover:text-brand-600 transition-colors">About</a></li>
          <li><a href="/contact" class="hover:text-brand-600 transition-colors">Contact</a></li>
          <li><a href="/privacy" class="hover:text-brand-600 transition-colors">Privacy</a></li>
          <li><a href="/terms" class="hover:text-brand-600 transition-colors">Terms</a></li>
        </ul>
        <div class="mt-6">
          <h2 class="mb-3 text-xs font-bold uppercase tracking-[2px] text-gray-500">Follow Us</h2>
          <div class="flex items-center gap-3">
            <a href="#" class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 hover:border-brand-300 hover:text-brand-600 transition-all">
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
            <a href="#" class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 hover:border-brand-300 hover:text-brand-600 transition-all">
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-12 flex flex-col items-center gap-4 border-t border-gray-200 pt-8 sm:flex-row sm:justify-between">
      <div class="flex items-center gap-2 text-xs text-gray-500">
        &copy; {year} RexBunny Services. All rights reserved.
      </div>
      <div class="flex gap-4 text-xs text-gray-500">
        <a href="/privacy" class="hover:text-gray-600">Privacy</a>
        <a href="/terms" class="hover:text-gray-600">Terms</a>
      </div>
    </div>
  </div>
</footer>
