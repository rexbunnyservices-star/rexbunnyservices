---
---

<div id="exit-popup" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/60 backdrop-blur-sm">
  <div class="relative mx-4 w-full max-w-md rounded-2xl border border-dark-700 bg-dark-900 p-8 shadow-2xl">
    <button
      id="close-popup"
      class="absolute right-4 top-4 text-dark-400 transition-colors hover:text-white"
      aria-label="Close"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="mb-4 text-center">
      <span class="mb-3 inline-block rounded-full bg-brand-600/10 px-3 py-1 text-xs font-semibold text-brand-400">
        Free Resource
      </span>
      <h3 class="mb-2 text-2xl font-bold text-white">Wait — Don't Leave Empty-Handed</h3>
      <p class="text-sm text-dark-400">
        Download our 20-point GEO checklist and start optimizing your site for AI search today.
      </p>
    </div>

    <div class="mb-6 space-y-3">
      <div class="flex items-center gap-2 text-sm text-dark-300">
        <span class="text-brand-400">✓</span> Get cited in ChatGPT, Gemini & Perplexity
      </div>
      <div class="flex items-center gap-2 text-sm text-dark-300">
        <span class="text-brand-400">✓</span> 20 actionable optimization steps
      </div>
      <div class="flex items-center gap-2 text-sm text-dark-300">
        <span class="text-brand-400">✓</span> No email required — instant download
      </div>
    </div>

    <a
      href="/geo-checklist"
      class="block w-full rounded-lg bg-brand-600 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-brand-500"
    >
      Get the Free Checklist →
    </a>

    <p class="mt-3 text-center text-xs text-dark-500">
      Or <a href="/lead-engine" class="text-brand-400 hover:text-brand-300">run a free audit</a> instead
    </p>
  </div>
</div>

<script>
  let popupShown = false;

  function showPopup() {
    if (popupShown) return;
    popupShown = true;
    const popup = document.getElementById("exit-popup");
    if (popup) {
      popup.classList.remove("hidden");
      popup.classList.add("flex");
    }
  }

  function hidePopup() {
    const popup = document.getElementById("exit-popup");
    if (popup) {
      popup.classList.add("hidden");
      popup.classList.remove("flex");
    }
  }

  document.addEventListener("mouseout", (e) => {
    if (e.clientY <= 0) showPopup();
  });

  document.getElementById("close-popup")?.addEventListener("click", hidePopup);
  document.getElementById("exit-popup")?.addEventListener("click", (e) => {
    if (e.target === e.currentTarget) hidePopup();
  });
</script>
