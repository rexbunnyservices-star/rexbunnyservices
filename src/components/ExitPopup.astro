---

---

<div
  id="exit-popup"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/60 backdrop-blur-sm"
>
  <div
    class="relative mx-4 w-full max-w-md rounded-2xl border border-gray-200 bg-white p-8 shadow-2xl"
  >
    <button
      id="close-popup"
      class="absolute right-4 top-4 text-gray-500 transition-colors hover:text-gray-900"
      aria-label="Close"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="mb-6 text-center">
      <span
        class="mb-3 inline-block rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-600"
      >
        Free Resource
      </span>
      <h3 class="mb-2 font-display text-2xl font-extrabold text-rex-dark">
        Get the 20-Point GEO Checklist
      </h3>
      <p class="text-sm text-gray-500">
        Enter your email and we'll send you the checklist instantly — every step to get cited in
        ChatGPT, Gemini &amp; Perplexity.
      </p>
    </div>

    <form id="checklist-form" class="mb-6 space-y-3">
      <input
        type="email"
        id="checklist-email"
        required
        placeholder="you@company.com"
        class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm text-gray-900 placeholder-gray-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
        aria-label="Email address"
      />
      <button
        type="submit"
        id="checklist-submit"
        class="block w-full rounded-xl bg-gradient-to-r from-brand-500 to-rex-orange py-3 text-center text-sm font-bold text-white shadow-lg shadow-brand-500/20 transition-all hover:shadow-xl hover:shadow-brand-500/30 hover:-translate-y-0.5 disabled:opacity-60"
      >
        Send Me the Free Checklist →
      </button>
    </form>

    <div
      id="checklist-success"
      class="mb-6 hidden rounded-xl border border-green-200 bg-green-50 p-4 text-center"
    >
      <p class="text-sm font-semibold text-green-800">Checklist sent! Check your inbox.</p>
      <p class="mt-1 text-xs text-green-600">
        Meanwhile, run your free AI visibility audit for an instant score.
      </p>
      <a
        href="/lead-engine"
        class="mt-3 inline-block text-sm font-semibold text-brand-600 hover:text-brand-700"
        >Run Free Audit →</a
      >
    </div>

    <p class="mt-3 text-center text-xs text-gray-500">
      Or <a href="/lead-engine" class="font-semibold text-brand-600 hover:text-brand-700"
        >run a free audit</a
      > instead
    </p>
  </div>
</div>

<script>
  let popupShown = false;

  function showPopup() {
    if (popupShown) return;
    popupShown = true;
    const popup = document.getElementById('exit-popup');
    if (popup) {
      popup.classList.remove('hidden');
      popup.classList.add('flex');
    }
  }

  function hidePopup() {
    const popup = document.getElementById('exit-popup');
    if (popup) {
      popup.classList.add('hidden');
      popup.classList.remove('flex');
    }
  }

  document.addEventListener('mouseout', (e) => {
    if (e.clientY <= 0) showPopup();
  });

  document.getElementById('close-popup')?.addEventListener('click', hidePopup);
  document.getElementById('exit-popup')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) hidePopup();
  });

  const form = document.getElementById('checklist-form');
  const emailInput = document.getElementById('checklist-email');
  const submitBtn = document.getElementById('checklist-submit');
  const successMsg = document.getElementById('checklist-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput?.value?.trim();
    if (!email) return;
    if (submitBtn) submitBtn.disabled = true;
    try {
      const res = await fetch('/api/checklist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      if (res.ok) {
        if (form) form.style.display = 'none';
        if (successMsg) successMsg.classList.remove('hidden');
      } else {
        if (submitBtn) submitBtn.disabled = false;
        if (emailInput) emailInput.classList.add('border-red-400');
      }
    } catch {
      if (submitBtn) submitBtn.disabled = false;
      if (emailInput) emailInput.classList.add('border-red-400');
    }
  });
</script>
