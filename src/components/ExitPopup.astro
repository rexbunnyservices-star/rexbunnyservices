---
---

<div id="exit-popup" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/60 backdrop-blur-sm">
  <div class="relative mx-4 w-full max-w-md rounded-2xl border border-gray-200 bg-white p-8 shadow-2xl">
    <button
      id="close-popup"
      class="absolute right-4 top-4 text-gray-500 transition-colors hover:text-gray-900"
      aria-label="Close"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="mb-6 text-center">
      <span class="mb-3 inline-block rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-600">
        Free Resource
      </span>
      <h3 class="mb-2 font-display text-2xl font-extrabold text-rex-dark">Wait — Don't Leave Empty-Handed</h3>
      <p class="text-sm text-gray-500">
        Download our 20-point GEO checklist and start optimizing your site for AI search today.
      </p>
    </div>

    <div class="mb-6 space-y-3">
      <div class="flex items-center gap-2.5 text-sm text-gray-600">
        <svg class="h-4 w-4 flex-shrink-0 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        Get cited in ChatGPT, Gemini & Perplexity
      </div>
      <div class="flex items-center gap-2.5 text-sm text-gray-600">
        <svg class="h-4 w-4 flex-shrink-0 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        20 actionable optimization steps
      </div>
      <div class="flex items-center gap-2.5 text-sm text-gray-600">
        <svg class="h-4 w-4 flex-shrink-0 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        No email required — instant download
      </div>
    </div>

    <a
      href="/geo-checklist"
      class="block w-full rounded-xl bg-gradient-to-r from-brand-500 to-rex-orange py-3 text-center text-sm font-bold text-white shadow-lg shadow-brand-500/20 transition-all hover:shadow-xl hover:shadow-brand-500/30 hover:-translate-y-0.5"
    >
      Get the Free Checklist →
    </a>

    <p class="mt-3 text-center text-xs text-gray-400">
      Or <a href="/lead-engine" class="font-semibold text-brand-600 hover:text-brand-700">run a free audit</a> instead
    </p>
  </div>
</div>

<script>
  let popupShown = false;

  function showPopup() {
    if (popupShown) return;
    popupShown = true;
    const popup = document.getElementById("exit-popup");
    if (popup) {
      popup.classList.remove("hidden");
      popup.classList.add("flex");
    }
  }

  function hidePopup() {
    const popup = document.getElementById("exit-popup");
    if (popup) {
      popup.classList.add("hidden");
      popup.classList.remove("flex");
    }
  }

  document.addEventListener("mouseout", (e) => {
    if (e.clientY <= 0) showPopup();
  });

  document.getElementById("close-popup")?.addEventListener("click", hidePopup);
  document.getElementById("exit-popup")?.addEventListener("click", (e) => {
    if (e.target === e.currentTarget) hidePopup();
  });
</script>
