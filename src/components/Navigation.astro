---
const links = [
  { href: "/", label: "Home" },
  { href: "/services/web-development", label: "Web Dev" },
  { href: "/services/seo", label: "SEO" },
  { href: "/services/ai-search-optimization", label: "AI Search (GEO)" },
  { href: "/lead-engine", label: "Free Audit" },
  { href: "/contact", label: "Contact" },
];
---

<nav class="fixed top-0 z-50 w-full border-b border-dark-700/50 bg-dark-950/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 text-xl font-bold tracking-tight text-white">
      <span class="text-brand-500">&lt;/&gt;</span>
      <span>REX<span class="text-brand-500"> Bunny</span></span>
    </a>

    <div class="hidden items-center gap-6 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-dark-200 transition-colors hover:text-brand-400"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/lead-engine"
        class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-500"
      >
        Get My AI Score
      </a>
    </div>

    <button class="md:hidden" aria-label="Menu" id="mobile-menu-btn">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</nav>
