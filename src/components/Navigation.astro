---
const links = [
  { href: "/", label: "Home" },
  { href: "/services/seo", label: "SEO" },
  { href: "/services/ai-search-optimization", label: "GEO" },
  { href: "/services/aeo", label: "AEO" },
  { href: "/services/web-development", label: "Web Dev" },
  { href: "/pricing", label: "Pricing" },
  { href: "/blog", label: "Blog" },
  { href: "/portfolio", label: "Case Studies" },
  { href: "/lead-engine", label: "Free Audit" },
  { href: "/contact", label: "Contact" },
];
---

<nav class="fixed top-0 z-50 w-full border-b border-dark-700/50 bg-dark-950/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center">
      <img src="/images/logo-mark.png" alt="REX Bunny" class="h-10 w-auto" />
    </a>

    <div class="hidden items-center gap-6 md:flex" id="desktop-nav">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-dark-200 transition-colors hover:text-brand-400"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/lead-engine"
        class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-500"
      >
        Get My AI Score
      </a>
    </div>

    <button class="md:hidden" aria-label="Menu" id="mobile-menu-btn">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div class="hidden border-t border-dark-800 bg-dark-950 md:hidden" id="mobile-menu">
    <div class="space-y-1 px-4 py-4">
      <a href="/" class="mb-2 block">
        <img src="/images/logo-mark.png" alt="REX Bunny" class="h-8 w-auto" />
      </a>
      {
        links.map((link) => (
          <a
            href={link.href}
            class="block rounded-lg px-3 py-2 text-sm font-medium text-dark-200 transition-colors hover:bg-dark-800 hover:text-brand-400"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/lead-engine"
        class="mt-2 block rounded-lg bg-brand-600 px-3 py-2 text-center text-sm font-semibold text-white transition-colors hover:bg-brand-500"
      >
        Get My AI Score
      </a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
  }
</script>
