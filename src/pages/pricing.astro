        popular: false,
      },
    ],
  },
  {
    id: "geo",
    name: "GEO",
    tagline: "Generative Engine Optimization",
    description: "Get your brand cited inside ChatGPT, Gemini, Perplexity, and Copilot responses. Entity engineering, LLM citation strategy, and AI crawl optimization.",
    plans: [
      {
        name: "GEO Sprint",
        tagline: "One-time foundation",
