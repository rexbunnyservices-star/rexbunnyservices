---

import BaseLayout from "../layouts/BaseLayout.astro";
import CalEmbed from "../components/CalEmbed.tsx";

const tiers = [
  {
    name: "Starter",
    tagline: "Get visible in AI search",
    price: "$1,500",
    period: "one-time",
    description: "Perfect for businesses ready to establish their AI search presence.",
    features: [
      "Full AI Visibility Audit",
      "llms.txt setup & optimization",
      "robots.txt AI crawler configuration",
      "Basic structured data (JSON-LD)",
      "Entity graph mapping",
      "30-day monitoring",
      "PDF report with roadmap",
    ],
    cta: "Start with Audit",
    href: "/lead-engine",
    popular: false,
  },
  {
    name: "Growth",
    tagline: "Dominate AI citations",
    price: "$4,500",
    period: "per month",
    description: "For businesses serious about being the #1 cited source in AI responses.",
    features: [
      "Everything in Starter",
      "Full GEO strategy & implementation",
      "LLM citation engineering",
      "Content restructuring for AI",
      "Weekly AI citation tracking",
      "Monthly performance reports",
      "Dedicated account manager",
      "Slack support channel",
    ],
    cta: "Book Strategy Call",
    href: "#",
    popular: true,
  },
  {
    name: "Enterprise",
    tagline: "Multi-location at scale",
    price: "Custom",
    period: "",
    description: "For multi-location businesses needing programmatic SEO and full-stack GEO.",
    features: [
      "Everything in Growth",
      "Programmatic city page generation",
      "Multi-location schema automation",
      "Custom n8n monitoring workflows",
      "Real-time AI citation alerts",
      "Quarterly strategy reviews",
      "Priority support & SLA",
      "White-label reporting",
    ],
    cta: "Contact Sales",
    href: "/contact",
    popular: false,
  },
];

const siteUrl = "https://rexbunnyservices.online";
---

<BaseLayout
  title="Pricing"
  description="Transparent pricing for AI Search Optimization, GEO, and web development services. Choose the plan that fits your growth goals."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "REX Bunny Service Packages",
    "itemListElement": tiers.map((tier, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "item": {
        "@type": "Product",
        "name": `${tier.name} — ${tier.tagline}`,
        "description": tier.description,
        "brand": { "@type": "Organization", "name": "REX Bunny Services" },
        "offers": tier.price !== "Custom" ? {
          "@type": "Offer",
          "price": tier.price.replace("$", ""),
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock",
          "url": `${siteUrl}/pricing`
        } : {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock",
          "url": `${siteUrl}/contact`
        }
      }
    }))
  })} />
  <section class="pt-24">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="mb-4 text-4xl font-extrabold text-white sm:text-5xl">
          Simple, Transparent Pricing
        </h1>
        <p class="mb-8 text-lg text-dark-400">
          No hidden fees. No long-term contracts. Just results.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {
          tiers.map((tier) => (
            <div
              class={`relative rounded-2xl border p-8 ${
                tier.popular
                  ? "border-brand-500 bg-dark-900 shadow-lg shadow-brand-500/10"
                  : "border-dark-800 bg-dark-900"
              }`}
            >
              {tier.popular && (
                <div class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-brand-600 px-4 py-1 text-xs font-semibold text-white">
                  Most Popular
                </div>
              )}
              <div class="mb-6">
                <h3 class="text-xl font-bold text-white">{tier.name}</h3>
                <p class="mt-1 text-sm text-dark-400">{tier.tagline}</p>
              </div>
              <div class="mb-6">
                <span class="text-4xl font-extrabold text-white">{tier.price}</span>
                {tier.period && (
                  <span class="text-sm text-dark-500">/{tier.period}</span>
                )}
              </div>
              <p class="mb-6 text-sm text-dark-400">{tier.description}</p>
              <ul class="mb-8 space-y-3">
                {tier.features.map((feature) => (
                  <li class="flex items-start gap-2 text-sm text-dark-300">
                    <span class="mt-0.5 text-brand-400">✓</span>
                    {feature}
                  </li>
                ))}
              </ul>
              {tier.href === "#" ? (
                <CalEmbed buttonText={tier.cta} className="w-full" client:load />
              ) : (
                <a
                  href={tier.href}
                  class={`block w-full rounded-lg py-3 text-center text-sm font-semibold transition-colors ${
                    tier.popular
                      ? "bg-brand-600 text-white hover:bg-brand-500"
                      : "border border-dark-700 text-white hover:border-brand-500 hover:text-brand-400"
                  }`}
                >
                  {tier.cta}
                </a>
              )}
            </div>
          ))
        }
      </div>

      <div class="mt-16 text-center">
        <h2 class="mb-4 text-2xl font-bold text-white">Not sure which plan?</h2>
        <p class="mb-6 text-dark-400">
          Start with a free audit. We'll review your results and recommend the right path.
        </p>
        <a
          href="/lead-engine"
          class="inline-block rounded-lg bg-brand-600 px-8 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-500"
        >
          Run Your Free Audit →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
