        ],
        cta: "Book Strategy Call",
        href: "#",
        popular: true,
      },
      {
        name: "GEO Enterprise",
        tagline: "Full-scale program",
        price: "$8,000",
        period: "per month",
        features: [
          "Everything in Growth",
          "12+ AI-optimized content pieces/mo",
          "Multi-engine competitor benchmarking",
          "Real-time citation alerts",
