      },
      {
        name: "Enterprise SEO",
        tagline: "50+ locations",
        price: "Custom",
        period: "",
        features: [
          "Everything in Growth",
          "Custom automation pipeline",
          "API integrations",
          "Dedicated SEO engineer",
