---
import BaseLayout from "../layouts/BaseLayout.astro";
import MainDashboard from "../components/MainDashboard.tsx";
---

<BaseLayout
  title="n8n Lead Dashboard | RexBunny Services"
  description="Internal dashboard for workflows, executions, leads and prospects."
  breadcrumbs={[{ name: "Dashboard", url: "/dashboard" }]}
>
  <section class="pt-24">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="mb-4 text-4xl font-extrabold text-gray-900 sm:text-5xl">
          <span class="text-brand-600">n8n Lead Dashboard</span>
        </h1>
        <p class="mb-8 text-lg text-gray-600">
          Workflows, executions, leads and prospects — all in one place.
        </p>
      </div>

      <div class="mx-auto max-w-6xl">
        <MainDashboard client:load />
      </div>
    </div>
  </section>
</BaseLayout>
