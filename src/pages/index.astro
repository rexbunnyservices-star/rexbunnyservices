---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetricCard from '../components/MetricCard.tsx';
import LeadAuditTool from '../components/LeadAuditTool.tsx';
import FAQ from '../components/FAQ.tsx';
import CalEmbed from '../components/CalEmbed.tsx';

// Live pipeline scale, read at build time from our own count-only endpoint.
// That endpoint returns a single integer and no records: the prospects
// collection holds emails and phone numbers, so its PocketBase list rule is
// admin-only and this page must never read it directly.
// This is prospects our own automated system is working — NOT client results.
const PIPELINE_FALLBACK = 1618;
let pipelineCount = PIPELINE_FALLBACK;
try {
  const res = await fetch('https://rexbunnyservices.online/api/pipeline-count', {
    signal: AbortSignal.timeout(4000),
  });
  const data = await res.json();
  if (Number.isFinite(data.totalItems)) pipelineCount = data.totalItems;
} catch {
  pipelineCount = PIPELINE_FALLBACK;
}
const pipelineFormatted = pipelineCount.toLocaleString('en-US');

const faqs = [
  {
    question: "What's the difference between SEO, GEO, and AEO?",
    answer:
      'SEO optimizes for traditional search engines like Google. GEO (Generative Engine Optimization) gets your brand cited in AI responses from ChatGPT, Gemini, and Perplexity. AEO (Answer Engine Optimization) makes your content the direct answer — featured snippets, voice search, Siri, Alexa, and Google AI Overviews. Most businesses need all three to cover every way customers search.',
  },
  {
    question: 'What is AEO and how is it different from GEO?',
    answer:
      "AEO (Answer Engine Optimization) focuses on making your content the direct answer that AI engines and voice assistants read aloud. Think featured snippets, 'position zero,' and Siri responses. GEO focuses on getting your brand cited as a source within AI responses. AEO = you ARE the answer. GEO = you're CITED in the answer. Both are essential in 2026.",
  },
  {
    question: 'How do you measure AI search and answer visibility?',
    answer:
      'We run periodic queries across GPT-4o, Gemini 2.0, Perplexity, Copilot, Google AI Overviews, and voice assistants. We track whether your brand appears, in what position, and in what context — and whether your content is extracted as the direct answer. We also monitor GPTBot crawl behavior and entity presence in knowledge graphs.',
  },
  {
    question: 'How long until I see results?',
    answer:
      'It depends on your market, competition, and how much of the site needs fixing. Some quick wins — schema, metadata, internal linking — show up within weeks; durable authority across every channel takes months of compounding work. Rather than quote a generic benchmark, we audit first, then commit to a timeline in writing for your specific site.',
  },
  {
    question: 'Can you optimize my existing site or do I need a rebuild?',
    answer:
      'We can optimize your existing site — most SEO, GEO, and AEO improvements are about structured data, content restructuring, and entity signals. Web development is only needed if your site has severe performance issues (Lighthouse < 50, 5+ second load times).',
  },
  {
    question: 'Do you offer web development as a standalone service?',
    answer:
      'Yes. AI search optimization is the core, but we also build the site itself — Lighthouse 95+ targets, sub-second load times, edge-deployed, and LLM-ready — plus lead generation, ad campaigns, and ecommerce dashboards. Each piece can be bought separately or run as one system.',
  },
  {
    question: "What's included in the free audit?",
    answer:
      'The audit checks your Lighthouse performance scores (LCP, CLS, TBT), AI crawlability (GPTBot access, llms.txt presence), structured data quality (JSON-LD completeness), featured snippet presence, and produces a composite Search Visibility Score across all channels. A full PDF report with recommendations is emailed to you.',
  },
];

const services = [
  {
    href: '/services/seo',
    image: '/images/services/ai-search.png',
    imageWidth: 760,
    imageHeight: 598,
    title: 'AI Search Optimization',
    subtitle: 'SEO · AEO · GEO',
    description:
      'Become discoverable across Google, ChatGPT, Gemini, Siri and AI Overviews through technical SEO, answer-engine content and LLM citation work.',
    logoClass: 'w-[82%] max-w-[300px] md:w-auto md:max-w-[320px]',
    accent: 'text-violet-600',
    accentBg: 'bg-violet-50',
    accentBorder: 'border-violet-200/50',
    span: 'col-span-1 row-span-2 md:col-span-1 md:row-span-2',
    features: [
      'Technical & on-page SEO',
      'Featured snippet & AI Overview capture',
      'LLM citation optimization',
      'Entity engineering for AI search',
    ],
  },
  {
    href: '/services/web-development',
    image: '/images/services/website-gen.png',
    imageWidth: 690,
    imageHeight: 760,
    title: 'Website Generation',
    subtitle: 'Built for Search Performance',
    description:
      'Fast, search-ready websites engineered for Lighthouse 95+, sub-second loads and clean AI crawling.',
    logoClass: 'w-[68%] max-w-[235px] md:w-auto md:max-w-[240px]',
    accent: 'text-blue-600',
    accentBg: 'bg-blue-50',
    accentBorder: 'border-blue-200/50',
    span: 'col-span-1 md:col-span-2',
    features: [
      'Lighthouse 95+ targets',
      'Sub-second load times',
      'LLM-crawlable HTML',
      'Edge-deployed architecture',
    ],
  },
  {
    href: '/services/lead-generation',
    image: '/images/services/lead-gen.png',
    imageWidth: 640,
    imageHeight: 760,
    title: 'Lead Generation',
    subtitle: 'Qualified Prospects On Demand',
    description:
      'Automated prospecting, enrichment and scoring workflows that hand sales teams verified decision-maker contacts.',
    logoClass: 'w-[66%] max-w-[220px] md:w-auto md:max-w-[150px]',
    accent: 'text-violet-600',
    accentBg: 'bg-violet-50',
    accentBorder: 'border-violet-200/50',
    span: 'col-span-1',
    features: [
      'Multi-source lead scraping',
      'AI-scored prospect pipeline',
      'Verified contact enrichment',
      'CRM-ready handoff',
    ],
  },
  {
    href: '/services/ad-campaigns',
    image: '/images/services/ad-campaigns.png',
    imageWidth: 674,
    imageHeight: 760,
    title: 'Ad Campaigns',
    subtitle: 'Google · Meta · AI Platforms',
    description:
      'Google, Meta and emerging AI ad campaigns managed around conversion, budget transparency and cost per qualified lead.',
    logoClass: 'w-[68%] max-w-[230px] md:w-auto md:max-w-[150px]',
    accent: 'text-fuchsia-600',
    accentBg: 'bg-fuchsia-50',
    accentBorder: 'border-fuchsia-200/50',
    span: 'col-span-1',
    features: [
      'Google & Meta ad management',
      'AI-platform ad optimization',
      'Conversion-focused creatives',
      'Budget transparency & CPL focus',
    ],
  },
  {
    href: '/services/ecommerce-dashboards',
    image: '/images/services/shopping-dashboards.png',
    imageWidth: 674,
    imageHeight: 760,
    title: 'Shopping Dashboards',
    subtitle: 'Amazon · Flipkart · Meesho · Shopify',
    description:
      'One operating view for marketplace performance, inventory, opportunities and competitors across every major sales channel.',
    logoClass: 'w-[68%] max-w-[230px] md:w-auto md:max-w-[240px]',
    accent: 'text-emerald-600',
    accentBg: 'bg-emerald-50',
    accentBorder: 'border-emerald-200/50',
    span: 'col-span-1 md:col-span-2',
    features: [
      'Amazon & Flipkart analytics',
      'Meesho & Shopify insights',
      'Sales & inventory dashboards',
      'Competitor price tracking',
    ],
  },
  {
    href: '/lead-engine',
    image: '/images/services/audit.png',
    imageWidth: 760,
    imageHeight: 749,
    title: 'Free Performance Audit',
    subtitle: 'Lighthouse · AI Crawlability · Schema',
    description:
      'See your performance, AI crawlability and structured-data gaps before you invest in a full website or search rebuild.',
    logoClass: 'w-[70%] max-w-[240px] md:w-auto md:max-w-[150px]',
    accent: 'text-brand-600',
    accentBg: 'bg-brand-50',
    accentBorder: 'border-brand-200/50',
    span: 'col-span-1',
    features: [
      'Lighthouse performance score',
      'AI crawlability check',
      'Structured data quality',
      'LLM citation potential',
    ],
  },
];
---

<BaseLayout
  title="Build, Grow & Automate"
  description="Build the site. Grow it in Google, ChatGPT and Siri. Automate the pipeline behind it. One founder, freelancer rates, agency-grade output."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    })}
  />

  <!-- ═══ HERO ═══ -->
  <section data-cursor-glow class="relative overflow-hidden pt-24">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-brand-50/50"></div>
    <div class="absolute inset-0 bg-brand-glow"></div>
    <div class="absolute inset-0 bg-noise pointer-events-none"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div
          data-reveal="fade-down"
          class="mb-6 inline-flex items-center rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-sm font-medium text-brand-700 opacity-0 shadow-premium"
        >
          From blank site to booked call
        </div>
        <h1
          data-reveal="glow-border"
          data-duration="1400"
          class="mb-6 font-display text-5xl font-extrabold leading-tight tracking-tight text-rex-dark sm:text-6xl lg:text-7xl opacity-0"
        >
          <span class="inline-block">Build.</span>{' '}
          <span
            class="inline-block bg-gradient-to-r from-brand-500 via-rex-orange to-rex-gold bg-[length:200%_auto] bg-clip-text text-transparent animate-gradient-shift"
            >Grow.</span
          >{' '}
          <span class="inline-block">Automate.</span>
        </h1>
        <p
          data-reveal="fade-up"
          data-delay="150"
          class="mb-4 text-lg text-gray-600 sm:text-xl opacity-0"
        >
          We build the site, grow your visibility across Google and AI search, then automate the
          follow-up that turns attention into pipeline. One founder does all three.
        </p>
        <p data-reveal="fade-up" data-delay="250" class="mb-10 text-base text-gray-500 opacity-0">
          Freelancer rates. Agency-grade output.
        </p>
        <div
          data-reveal="fade-up"
          data-delay="300"
          data-stagger="140"
          class="mx-auto mb-10 grid max-w-4xl gap-4 sm:grid-cols-3"
        >
          {
            [
              {
                phase: 'Build',
                title: 'The site',
                desc: 'Fast, schema-clean, built to be read by AI.',
              },
              {
                phase: 'Grow',
                title: 'Every search channel',
                desc: 'Found on Google, ChatGPT, Siri, AI Overviews.',
              },
              {
                phase: 'Automate',
                title: 'The pipeline',
                desc: 'Leads found, enriched and scored without you.',
              },
            ].map((p, i) => (
              <div
                data-reveal-stagger-item
                class="rounded-2xl border border-gray-200 bg-white/70 p-5 text-left opacity-0 backdrop-blur-sm transition-colors hover:border-brand-300"
              >
                <div class="mb-1 text-[10px] font-bold uppercase tracking-[0.2em] text-brand-500">
                  {p.phase}
                </div>
                <h2 class="mb-1 text-base font-bold text-rex-dark">{p.title}</h2>
                <p class="text-xs leading-relaxed text-gray-500">{p.desc}</p>
                {i === 2 && (
                  <p class="mt-3 border-t border-gray-100 pt-2 text-[11px] leading-snug text-gray-400">
                    <span class="font-semibold text-brand-500">{pipelineFormatted}</span> prospects
                    in our pipeline — pipeline scale, not client results.
                  </p>
                )}
              </div>
            ))
          }
        </div>
        <div
          data-reveal="fade-up"
          data-delay="350"
          class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center opacity-0"
        >
          <a
            href="/lead-engine"
            data-magnetic
            class="relative overflow-hidden rounded-xl bg-gradient-to-r from-brand-500 to-rex-orange px-8 py-4 text-base font-semibold text-white shadow-premium-glow transition-all hover:shadow-[0_0_40px_rgba(249,115,22,0.35)] hover:-translate-y-0.5"
          >
            <span
              class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent animate-shimmer"
            ></span>
            <span class="relative">Run Your Free Build &amp; Search Audit →</span>
          </a>
          <span data-magnetic><CalEmbed buttonText="Book a Strategy Call" client:load /></span>
        </div>
        <div
          data-reveal="fade-up"
          data-delay="450"
          class="mt-10 flex items-center justify-center gap-6 text-sm text-gray-500 opacity-0"
        >
          <span class="flex items-center gap-1.5">
            <svg
              class="h-4 w-4 text-green-500"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M5 13l4 4L19 7"></path></svg
            >
            No credit card
          </span>
          <span class="flex items-center gap-1.5">
            <svg
              class="h-4 w-4 text-green-500"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M5 13l4 4L19 7"></path></svg
            >
            30-second scan
          </span>
          <span class="flex items-center gap-1.5">
            <svg
              class="h-4 w-4 text-green-500"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M5 13l4 4L19 7"></path></svg
            >
            PDF report included
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SCOPE ═══ -->
  <section class="border-y border-gray-200 bg-gray-50 py-14">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="mb-3 text-2xl font-extrabold text-rex-dark">Need something specific?</h2>
      <p class="mb-6 text-sm text-gray-500">
        The prices below are starting points, not limits. Pick a channel or tell us the outcome you
        want — we'll scope the work and price it to your project.
      </p>
      <a
        href="/contact"
        class="inline-block rounded-lg bg-brand-600 px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-500"
      >
        Scope My Project →
      </a>
    </div>
  </section>

  <!-- ═══ METRICS ═══ -->
  <section
    class="relative border-y border-brand-200/50 bg-gradient-to-r from-brand-50 via-white to-brand-50"
  >
    <div class="absolute inset-0 bg-noise pointer-events-none opacity-[0.35]"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div
        data-reveal="fade-down"
        class="mb-8 text-center text-sm font-semibold uppercase tracking-[2px] text-brand-500 opacity-0"
      >
        Systems Built to Run Themselves
      </div>
      <div class="grid grid-cols-2 gap-6 md:grid-cols-4">
        <MetricCard value="0.3s" label="Avg LCP" description="Largest Contentful Paint" index={0} />
        <MetricCard value="98" label="Lighthouse" description="Performance Score" index={1} />
        <MetricCard
          value="100%"
          label="Schema Score"
          description="Structured Data Depth"
          index={2}
        />
        <MetricCard
          value="Scoped"
          label="per engagement"
          description="Timelines Fixed in Writing"
          index={3}
        />
      </div>
    </div>
  </section>

  <!-- ═══ SERVICES — DAY96-INSPIRED CUTOUT GRID ═══ -->
  <section id="services" class="relative scroll-mt-24 overflow-hidden bg-[#f3f4f6] py-24">
    <div class="absolute inset-0 bg-noise pointer-events-none opacity-[0.12]"></div>
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div
        data-reveal="fade-up"
        data-stagger="80"
        class="mb-14 grid items-end gap-8 opacity-0 lg:grid-cols-[1.35fr_0.65fr] lg:gap-16"
      >
        <div data-reveal-stagger-item>
          <div
            class="mb-5 flex items-center gap-2 text-sm font-bold uppercase tracking-[0.2em] text-brand-600"
          >
            <span class="h-px w-8 bg-brand-500"></span>
            What We Do
          </div>
          <h2
            data-reveal-stagger-item
            class="max-w-3xl font-display text-5xl font-extrabold leading-[0.98] tracking-[-0.045em] text-gray-950 md:text-6xl"
          >
            Six Ways We Make<br />You Visible.
          </h2>
        </div>
        <p
          data-reveal-stagger-item
          class="max-w-md pb-1 text-base leading-relaxed text-gray-500 md:text-lg"
        >
          Search, websites, lead engines, campaigns and commerce—built as one connected visibility
          system.
        </p>
      </div>

      <div
        class="grid grid-cols-1 items-stretch gap-4 md:auto-rows-[320px] md:grid-cols-3 md:gap-4"
      >
        {
          services.map((s, i) => (
            <a
              href={s.href}
              data-reveal="fade-up"
              data-delay={120 + i * 70}
              class={`group relative min-h-[440px] overflow-hidden rounded-[1.75rem] border border-gray-200/80 bg-white p-6 opacity-0 shadow-premium transition-all duration-500 hover:-translate-y-1 hover:border-gray-300 hover:shadow-premium-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-4 focus-visible:ring-offset-[#f3f4f6] md:min-h-0 md:p-6 ${
                i === 0
                  ? 'md:col-span-1 md:row-span-2'
                  : i === 1 || i === 4
                    ? 'md:col-span-2'
                    : 'md:col-span-1'
              }`}
            >
              <div
                class={`grid h-full min-h-[392px] grid-cols-1 items-stretch gap-5 md:min-h-0 ${
                  i === 0
                    ? 'md:grid-cols-1 md:grid-rows-[300px_minmax(0,1fr)] md:gap-3'
                    : i === 1 || i === 4
                      ? 'md:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] md:gap-3'
                      : 'md:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)] md:gap-3'
                }`}
              >
                <div
                  class={`relative z-10 flex h-full flex-col justify-center ${
                    i === 0 ? 'md:order-2' : 'md:order-1'
                  }`}
                >
                  <div
                    class={`text-xs font-bold uppercase tracking-[0.18em] ${
                      i === 0 ? 'mb-4 md:mb-3' : i >= 2 && i !== 4 ? 'mb-1 md:mb-1' : 'mb-4'
                    } ${s.accent}`}
                  >
                    Service {String(i + 1).padStart(2, '0')}
                  </div>
                  <h3
                    class={`font-display text-3xl font-extrabold leading-[1.05] tracking-[-0.035em] text-gray-950 ${
                      i === 0 || i === 1 || i === 4
                        ? 'mb-3 md:mb-3 md:text-4xl'
                        : i === 5
                          ? 'mb-1 md:mb-1 md:text-2xl md:leading-[0.95]'
                          : 'mb-1 md:mb-1 md:text-3xl'
                    }`}
                  >
                    {s.title}
                  </h3>
                  <p
                    class={`text-xs font-bold uppercase tracking-[0.12em] text-gray-400 ${
                      i === 5
                        ? 'mb-1 md:mb-1 md:text-[0.55rem] md:leading-[1.05]'
                        : i >= 2 && i !== 4
                          ? 'mb-1 md:mb-1 md:text-[0.6rem] md:leading-[1.2]'
                          : 'mb-4'
                    }`}
                  >
                    {s.subtitle}
                  </p>
                  <p
                    class={`mb-6 max-w-sm text-sm leading-relaxed text-gray-500 ${
                      i === 0 || i === 1
                        ? 'md:text-[0.95rem]'
                        : i === 4
                          ? 'md:mb-2 md:text-[0.8rem] md:leading-[1.3]'
                          : i === 5
                            ? 'md:mb-2 md:text-[0.68rem] md:leading-[1.15]'
                            : 'md:mb-2 md:text-[0.75rem] md:leading-[1.25]'
                    }`}
                  >
                    {s.description}
                  </p>
                  <span
                    class={`mt-auto inline-flex w-fit items-center gap-2 font-bold text-gray-900 ${
                      i >= 2 && i !== 4 ? 'text-xs' : 'text-sm'
                    }`}
                  >
                    Explore service
                    <span
                      class={`grid ${
                        i >= 2 && i !== 4 ? 'h-7 w-7' : 'h-8 w-8'
                      } place-items-center rounded-full ${
                        s.accentBg
                      } transition-transform duration-300 group-hover:translate-x-1`}
                    >
                      <svg
                        class={`${i >= 2 && i !== 4 ? 'h-3.5 w-3.5' : 'h-4 w-4'} ${s.accent}`}
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2.25"
                          d="M5 12h14m-6-6 6 6-6 6"
                        />
                      </svg>
                    </span>
                  </span>
                </div>

                <div
                  class={`flex min-h-[220px] items-center justify-center self-stretch md:min-h-0 ${
                    i === 0 ? 'md:order-1' : 'md:order-2'
                  }`}
                >
                  <img
                    src={s.image}
                    alt=""
                    aria-hidden="true"
                    width={s.imageWidth}
                    height={s.imageHeight}
                    class={`h-auto select-none object-contain transition-transform duration-500 ease-out group-hover:scale-[1.025] ${s.logoClass}`}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ PROOF (verifiable — not testimonials) ═══ -->
  <section class="relative border-y border-gray-200 bg-gradient-to-b from-gray-50 to-white py-24">
    <div class="absolute inset-0 bg-noise pointer-events-none opacity-[0.2]"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div
        data-reveal="fade-up"
        class="mb-4 flex items-center justify-center gap-2 text-sm font-semibold uppercase tracking-[2px] text-brand-500 opacity-0"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
          ></path></svg
        >
        Check me, don't trust me
      </div>
      <h2
        data-reveal="fade-up"
        data-delay="100"
        class="mb-4 text-center font-display text-4xl font-extrabold text-rex-dark opacity-0"
      >
        Check Me, Don't Trust Me.
      </h2>
      <p data-reveal="fade-up" data-delay="200" class="mb-14 text-center text-gray-500 opacity-0">
        Every claim below is something you can verify yourself, right now.
      </p>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          [
            {
              href: 'https://pagespeed.web.dev/analysis/https-rexbunnyservices-online/analysis?form_factor=desktop',
              external: true,
