---
import BaseLayout from "../layouts/BaseLayout.astro";
import MetricCard from "../components/MetricCard.tsx";
import LeadAuditTool from "../components/LeadAuditTool.tsx";
import FAQ from "../components/FAQ.tsx";
import CalEmbed from "../components/CalEmbed.tsx";

const faqs = [
  {
    question: "What's the difference between SEO, GEO, and AEO?",
    answer: "SEO optimizes for traditional search engines like Google. GEO (Generative Engine Optimization) gets your brand cited in AI responses from ChatGPT, Gemini, and Perplexity. AEO (Answer Engine Optimization) makes your content the direct answer — featured snippets, voice search, Siri, Alexa, and Google AI Overviews. Most businesses need all three to cover every way customers search.",
  },
  {
    question: "What is AEO and how is it different from GEO?",
    answer: "AEO (Answer Engine Optimization) focuses on making your content the direct answer that AI engines and voice assistants read aloud. Think featured snippets, 'position zero,' and Siri responses. GEO focuses on getting your brand cited as a source within AI responses. AEO = you ARE the answer. GEO = you're CITED in the answer. Both are essential in 2026.",
  },
  {
    question: "How do you measure AI search and answer visibility?",
    answer: "We run periodic queries across GPT-4o, Gemini 2.0, Perplexity, Copilot, Google AI Overviews, and voice assistants. We track whether your brand appears, in what position, and in what context — and whether your content is extracted as the direct answer. We also monitor GPTBot crawl behavior and entity presence in knowledge graphs.",
  },
  {
    question: "How long until I see results?",
    answer: "SEO results typically show in 4-12 weeks. Initial AI citations (GEO) appear within 4-8 weeks. AEO results — featured snippets and direct answers — can appear in as little as 2-4 weeks with proper schema and content structuring. Full authority across all channels builds over 3-6 months.",
  },
  {
    question: "Can you optimize my existing site or do I need a rebuild?",
    answer: "We can optimize your existing site — most SEO, GEO, and AEO improvements are about structured data, content restructuring, and entity signals. Web development is only needed if your site has severe performance issues (Lighthouse < 50, 5+ second load times).",
  },
  {
    question: "Do you offer web development as a standalone service?",
    answer: "Yes. While our core marketing services are SEO, GEO, and AEO, we also offer web development for clients who need a high-performance site built from the ground up — Lighthouse 95+, sub-second load times, edge-deployed, and LLM-ready. It can be bundled with our marketing services or purchased separately.",
  },
  {
    question: "What's included in the free audit?",
    answer: "The audit checks your Lighthouse performance scores (LCP, CLS, TBT), AI crawlability (GPTBot access, llms.txt presence), structured data quality (JSON-LD completeness), featured snippet presence, and produces a composite Search Visibility Score across all channels. A full PDF report with recommendations is emailed to you.",
  },
];

const siteUrl = "https://rexbunnyservices.online";

const services = [
  {
    href: "/services/seo",
    icon: "/images/icons/icon-seo.svg",
    title: "SEO",
    subtitle: "Traditional & Local Search",
    accent: "text-brand-600",
    accentBg: "bg-brand-100",
    features: ["Technical & on-page SEO", "Programmatic local schema", "500+ city page automation", "GSC rank tracking"],
  },
  {
    href: "/services/ai-search-optimization",
    icon: "/images/icons/icon-geo.svg",
    title: "GEO",
    subtitle: "Generative Engine Optimization",
    accent: "text-rex-violet",
    accentBg: "bg-violet-100",
    features: ["Entity engineering for AI", "LLM citation optimization", "AI crawl strategy", "Source score boosting"],
  },
  {
    href: "/services/aeo",
    icon: "/images/icons/icon-aeo.svg",
    title: "AEO",
    subtitle: "Answer Engine Optimization",
    accent: "text-rex-teal",
    accentBg: "bg-emerald-100",
    features: ["Featured snippet capture", "Voice & assistant readiness", "AI Overview integration", "Direct answer engineering"],
    badge: { text: "New Service", class: "text-rex-teal" },
  },
  {
    href: "/services/web-development",
    icon: "/images/icons/icon-webdev.svg",
    title: "Web Dev",
    subtitle: "Built for Search Performance",
    accent: "text-rex-blue",
    accentBg: "bg-blue-100",
    features: ["Lighthouse 95+ guaranteed", "Sub-second load times", "LLM-crawlable HTML", "Edge-deployed architecture"],
  },
  {
    href: "/services/ai-visual",
    icon: "/images/icons/icon-aivisual.svg",
    title: "AI Visual",
    subtitle: "AI-Generated Visual Content",
    accent: "text-rex-pink",
    accentBg: "bg-fuchsia-100",
    features: ["Social graphics & video ads", "Product imagery & brand kits", "AI headshots & 3D mockups", "Delivered in days, not weeks"],
  },
];
---

<BaseLayout
  title="Marketing Agency for AI & Search | SEO, GEO & AEO"
  description="RexBunny Services is a marketing agency specializing in SEO, Generative Engine Optimization (GEO), and Answer Engine Optimization (AEO). We make your brand visible in every search — Google, ChatGPT, Gemini, Siri, and beyond."
>
  <!-- FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  })} />

  <!-- Hero -->
  <section data-cursor-glow class="relative overflow-hidden pt-24">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-brand-50/50" />
    <div class="absolute inset-0 bg-brand-glow" />
    <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div data-reveal="fade-down" class="mb-6 inline-flex items-center rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-sm font-medium text-brand-700 opacity-0">
          AI Search &amp; Marketing Agency
        </div>
        <h1 data-reveal="scale-in" class="mb-6 font-display text-5xl font-extrabold leading-tight tracking-tight text-rex-dark sm:text-6xl lg:text-7xl opacity-0">
          The Marketing Agency That Makes You{" "}
          <span class="bg-gradient-to-r from-brand-500 via-rex-orange to-rex-gold bg-clip-text text-transparent animate-gradient-shift bg-[length:200%_200%]">
            Visible in Every Search
          </span>
        </h1>
        <p data-reveal="fade-up" data-delay="150" class="mb-4 text-lg text-gray-600 sm:text-xl opacity-0">
          SEO. GEO. AEO. We cover every way your customers search — Google, ChatGPT, Siri, Alexa, Gemini, and Perplexity.
        </p>
        <p data-reveal="fade-up" data-delay="250" class="mb-10 text-base text-gray-400 opacity-0">
          We engineer your brand into traditional search, AI citations, and direct answer engines — so you're found everywhere your customers are looking.
        </p>
        <div data-reveal="fade-up" data-delay="350" class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center opacity-0">
          <a
            href="/lead-engine"
            data-magnetic
            class="relative overflow-hidden rounded-xl bg-gradient-to-r from-brand-500 to-rex-orange px-8 py-4 text-base font-semibold text-white shadow-xl shadow-brand-500/30 transition-all hover:shadow-2xl hover:shadow-brand-500/40 hover:-translate-y-0.5"
          >
            <span class="absolute inset-0 bg-[length:200%_100%] bg-gradient-to-r from-transparent via-white/20 to-transparent animate-shimmer" />
            <span class="relative">Run Your Free AI Visibility Audit →</span>
          </a>
          <span data-magnetic><CalEmbed buttonText="Book a Strategy Call" client:load /></span>
        </div>
        <div data-reveal="fade-up" data-delay="450" class="mt-10 flex items-center justify-center gap-6 text-sm text-gray-400 opacity-0">
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            No credit card
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            30-second scan
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            PDF report included
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Branded Metrics Bar -->
  <section class="relative border-y border-brand-200/50 bg-gradient-to-r from-brand-50 via-white to-brand-50 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div data-reveal="fade-up" class="mb-6 text-center text-sm font-semibold uppercase tracking-[2px] text-brand-500 opacity-0">
        A Marketing Agency Built for the AI Era
      </div>
      <div class="grid grid-cols-2 gap-6 md:grid-cols-4">
        <MetricCard value="0.3s" label="Avg LCP" description="Largest Contentful Paint" index={0} />
        <MetricCard value="98" label="Lighthouse" description="Performance Score" index={1} />
        <MetricCard value="100%" label="Schema Score" description="Structured Data Depth" index={2} />
        <MetricCard value="4-8 wk" label="to AI Cite" description="First LLM Citation" index={3} />
      </div>
    </div>
  </section>

  <!-- Five Service Pillars -->
  <section class="py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div data-reveal="fade-up" class="mb-4 flex items-center justify-center gap-2 text-sm font-semibold uppercase tracking-[2px] text-brand-500 opacity-0">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        What We Do
      </div>
      <h2 data-reveal="fade-up" data-delay="100" class="mb-4 text-center font-display text-4xl font-extrabold text-rex-dark opacity-0">Five Ways We Make You Visible</h2>
      <p data-reveal="fade-up" data-delay="200" class="mb-14 text-center text-gray-500 opacity-0">Every channel your customers search — we make sure you're there.</p>
      <div class="grid gap-5 md:grid-cols-5">
        {services.map((s, i) => (
          <a
            href={s.href}
            data-reveal="fade-up"
            data-delay={300 + i * 100}
            data-tilt
            class="group relative rounded-2xl border border-gray-200 bg-white p-6 transition-all duration-500 hover:shadow-xl hover:-translate-y-1 overflow-hidden opacity-0"
          >
            <div class={`absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 ${s.accentBg}`} />
            <div class="relative">
              <div class={`mb-4 flex h-12 w-12 items-center justify-center rounded-xl ${s.accentBg} ${s.accent}`}>
                <img src={s.icon} alt="" class="h-6 w-6" loading="lazy" decoding="async" />
              </div>
              <h3 class={`mb-1 text-lg font-extrabold ${s.accent} group-hover:scale-105 transition-transform`}>{s.title}</h3>
              <p class="mb-3 text-xs font-medium text-gray-400 uppercase tracking-wider">{s.subtitle}</p>
              <ul class="space-y-1.5 text-sm text-gray-500">
                {s.features.map((f) => (
                  <li class="flex items-start gap-1.5">
                    <svg class={`mt-0.5 h-3.5 w-3.5 flex-shrink-0 ${s.accent}`} fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                    {f}
                  </li>
                ))}
              </ul>
              {s.badge && (
                <div class={`mt-4 inline-flex items-center rounded-full bg-gradient-to-r ${s.accentBg} px-3 py-1 text-[11px] font-bold uppercase tracking-wider ${s.accent}`}>
                  {s.badge.text}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Social Proof: Testimonials -->
  <section class="border-y border-gray-200 bg-gradient-to-b from-gray-50 to-white py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div data-reveal="fade-up" class="mb-4 flex items-center justify-center gap-2 text-sm font-semibold uppercase tracking-[2px] text-brand-500 opacity-0">
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z"/></svg>
        Testimonials
      </div>
      <h2 data-reveal="fade-up" data-delay="100" class="mb-4 text-center font-display text-4xl font-extrabold text-rex-dark opacity-0">Results That Speak</h2>
      <p data-reveal="fade-up" data-delay="200" class="mb-14 text-center text-gray-500 opacity-0">Real outcomes from real clients.</p>
      <div class="grid gap-6 md:grid-cols-3">
        {
          [
            {
              quote: "RexBunny didn't just rebuild our site — they rebuilt our business. The performance gains translated directly to revenue.",
              author: "Sarah Chen",
              role: "CTO, CloudMetrics",
              metric: "+96% conversions",
            },
            {
              quote: "We went from invisible in local search to dominating every market we serve. The ROI was evident within the first quarter.",
              author: "Dr. James Park",
              role: "Founder, BrightSmile Dental",
              metric: "+312% traffic",
            },
            {
              quote: "Our products now show up when people ask AI about home furniture. That's a completely new channel we never had before.",
              author: "Erik Lindqvist",
              role: "CEO, Nordic Home Co.",
              metric: "23 AI citations/mo",
            },
          ].map((t, i) => (
            <div data-reveal="blur-in" data-delay={i * 150} class="group rounded-2xl border border-gray-200 bg-white p-8 transition-all duration-500 hover:shadow-xl hover:-translate-y-1 opacity-0">
              <div class="mb-4 flex items-center gap-1.5">
                {[...Array(5)].map(() => (
                  <svg class="h-4 w-4 text-rex-gold" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                ))}
              </div>
              <div class="mb-4 text-3xl font-extrabold bg-gradient-to-r from-brand-500 to-rex-orange bg-clip-text text-transparent">{t.metric}</div>
              <p class="mb-5 text-sm text-gray-600 leading-relaxed">"{t.quote}"</p>
              <div class="flex items-center gap-3 border-t border-gray-100 pt-4">
                <div class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-brand-400 to-rex-orange text-xs font-bold text-white">
                  {t.author.charAt(0)}
                </div>
                <div>
                  <div class="text-sm font-bold text-gray-900">{t.author}</div>
                  <div class="text-xs text-gray-400">{t.role}</div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Client Logos Bar -->
  <section class="py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p data-reveal="fade-in" class="mb-8 text-center text-sm font-semibold uppercase tracking-[2px] text-gray-400 opacity-0">
        Trusted by forward-thinking brands
      </p>
      <div data-reveal="fade-in" data-delay="200" class="flex flex-wrap items-center justify-center gap-6 opacity-0">
        {["CloudMetrics", "BrightSmile Dental", "Nordic Home Co.", "TechVault", "ScaleUp Labs"].map((name) => (
          <div class="rounded-xl border border-gray-200 bg-white px-6 py-3 text-sm font-semibold text-gray-500 transition-all hover:shadow-md hover:border-gray-300 hover:opacity-100 opacity-60">
            {name}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Case Studies -->
  <section class="border-y border-gray-200 bg-gradient-to-b from-gray-50 to-white py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 flex items-end justify-between">
        <div>
          <div data-reveal="fade-up" class="mb-2 flex items-center gap-2 text-sm font-semibold uppercase tracking-[2px] text-brand-500 opacity-0">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            Case Studies
          </div>
          <h2 data-reveal="fade-up" data-delay="100" class="font-display text-4xl font-extrabold text-rex-dark opacity-0">Proven Results</h2>
          <p data-reveal="fade-up" data-delay="200" class="text-gray-500 opacity-0">Real outcomes from real clients. Every metric verified.</p>
        </div>
        <a href="/portfolio" class="hidden text-sm font-semibold text-brand-600 hover:text-brand-700 sm:block">
          View All Case Studies →
        </a>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {
          [
            {
              title: "SaaS Platform Rebuild",
              client: "CloudMetrics",
              service: "Web Development",
              desc: "From 6s to 0.4s LCP. Complete platform rebuild using Astro + Preact Islands.",
              metrics: [
                { label: "Lighthouse", value: "98" },
                { label: "Traffic", value: "+142%" },
                { label: "Conversions", value: "+96%" },
              ],
              color: "text-rex-blue",
              slug: "saas-platform-rebuild",
            },
            {
              title: "Dental Chain Local SEO",
              client: "BrightSmile Dental",
              service: "SEO",
              desc: "120+ city pages with automated schema. Programmatic local SEO at scale.",
              metrics: [
                { label: "Lighthouse", value: "96" },
                { label: "Traffic", value: "+312%" },
                { label: "LCP", value: "0.6s" },
              ],
              color: "text-brand-600",
              slug: "dental-chain-local-seo",
            },
            {
              title: "E-Commerce AI Visibility",
              client: "Nordic Home Co.",
              service: "AI Search Optimization",
              desc: "GEO optimization that got a brand cited in ChatGPT, Perplexity, and Gemini.",
              metrics: [
                { label: "Lighthouse", value: "97" },
                { label: "Traffic", value: "+89%" },
                { label: "Conversions", value: "+45%" },
              ],
              color: "text-rex-violet",
              slug: "ecommerce-ai-visibility",
            },
          ].map((cs, i) => (
            <a
              href={`/portfolio/${cs.slug}`}
              data-reveal="fade-up"
              data-delay={i * 120}
              data-tilt
              class="group rounded-2xl border border-gray-200 bg-white p-6 transition-all duration-500 hover:shadow-xl hover:-translate-y-1 opacity-0"
            >
              <div class={`mb-3 text-xs font-extrabold uppercase tracking-wider ${cs.color}`}>
                {cs.service}
              </div>
              <h3 class="mb-1 font-display text-lg font-bold text-rex-dark group-hover:text-brand-600 transition-colors">
                {cs.title}
              </h3>
              <p class="mb-1 text-xs text-gray-400">{cs.client}</p>
              <p class="mb-4 text-sm text-gray-500">{cs.desc}</p>
              <div class="flex flex-wrap gap-2">
                {cs.metrics.map((m) => (
                  <span class="rounded-lg bg-gray-100 px-2.5 py-1 text-xs text-gray-500">
                    <span class="font-extrabold text-rex-dark">{m.value}</span> {m.label}
                  </span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a href="/portfolio" class="text-sm font-semibold text-brand-600 hover:text-brand-700">
          View All Case Studies →
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  <section class="py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 flex items-end justify-between">
        <div>
          <div data-reveal="fade-up" class="mb-2 flex items-center gap-2 text-sm font-semibold uppercase tracking-[2px] text-brand-500 opacity-0">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
            Blog
          </div>
          <h2 data-reveal="fade-up" data-delay="100" class="font-display text-4xl font-extrabold text-rex-dark opacity-0">From the Blog</h2>
          <p data-reveal="fade-up" data-delay="200" class="text-gray-500 opacity-0">GEO strategies, SEO tactics, and web performance guides.</p>
        </div>
        <a href="/blog" class="hidden text-sm font-semibold text-brand-600 hover:text-brand-700 sm:block">
          View All Posts →
        </a>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {
          [
            {
              title: "How to Get Your Brand Cited in ChatGPT",
              date: "June 22, 2026",
              desc: "Step-by-step guide to optimizing your website so ChatGPT recommends your brand.",
              tags: ["GEO", "ChatGPT"],
              slug: "get-cited-in-chatgpt",
            },
            {
              title: "What is Generative Engine Optimization (GEO)?",
              date: "June 15, 2026",
              desc: "A complete guide to optimizing your website for AI search engines.",
              tags: ["GEO", "AI Search"],
              slug: "what-is-geo",
            },
            {
              title: "llms.txt Explained: The File Every Website Needs",
              date: "May 28, 2026",
              desc: "What is llms.txt, why it matters, and how to create one in under 10 minutes.",
              tags: ["Technical", "AI Search"],
              slug: "llms-txt-explained",
            },
          ].map((post, i) => (
            <a
              href={`/blog/${post.slug}`}
              data-reveal="fade-up"
              data-delay={i * 120}
              class="group rounded-2xl border border-gray-200 bg-white p-6 transition-all duration-500 hover:shadow-xl hover:-translate-y-1 opacity-0"
            >
              <div class="mb-2 flex items-center gap-2 text-xs text-gray-400">
                <span class="flex h-1.5 w-1.5 rounded-full bg-brand-400" />
                {post.date}
              </div>
              <h3 class="mb-2 font-display text-lg font-bold text-rex-dark group-hover:text-brand-600 transition-colors">
                {post.title}
              </h3>
              <p class="mb-4 text-sm text-gray-500">{post.desc}</p>
              <div class="flex flex-wrap gap-2">
                {post.tags.map((tag) => (
                  <span class="rounded-lg bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-600">{tag}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a href="/blog" class="text-sm font-semibold text-brand-600 hover:text-brand-700">
          View All Posts →
        </a>
      </div>
    </div>
  </section>

  <!-- Lead Engine Embed -->
  <section data-reveal="fade-up" class="relative overflow-hidden bg-gradient-to-b from-gray-50 to-white py-24 opacity-0" id="audit">
    <div class="absolute inset-0 bg-brand-glow" />
    <div class="relative mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
      <div class="mb-4 flex items-center justify-center gap-2 text-sm font-semibold uppercase tracking-[2px] text-brand-500">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        Free Audit
      </div>
      <h2 class="mb-2 text-center font-display text-4xl font-extrabold text-rex-dark">Is Your Site Ready for AI Search?</h2>
      <p class="mb-8 text-center text-gray-500">Find out in 30 seconds. Free audit, no credit card.</p>
      <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-xl">
        <LeadAuditTool client:visible />
      </div>
      <p class="mt-4 text-center text-xs text-gray-400">
        We'll check: Lighthouse Performance, AI Crawlability, Structured Data Quality, and LLM Citation Potential.
      </p>
    </div>
  </section>

  <!-- Process -->
  <section class="py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div data-reveal="fade-up" class="mb-4 flex items-center justify-center gap-2 text-sm font-semibold uppercase tracking-[2px] text-brand-500 opacity-0">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        Process
      </div>
      <h2 data-reveal="fade-up" data-delay="100" class="mb-2 text-center font-display text-4xl font-extrabold text-rex-dark opacity-0">The RexBunny Marketing Blueprint</h2>
      <p data-reveal="fade-up" data-delay="200" class="mb-14 text-center text-gray-500 opacity-0">A proven 4-step methodology to dominate every search channel.</p>
      <div class="grid gap-6 md:grid-cols-4">
        {[
          { step: "01", title: "Audit", desc: "Full diagnostic — SEO health, AI crawlability, entity presence, answer extraction potential." },
          { step: "02", title: "Strategize", desc: "Build a unified plan across SEO, GEO, and AEO. Identify gaps in every search channel." },
          { step: "03", title: "Implement", desc: "Execute the strategy — technical SEO, entity engineering, answer optimization, or performance rebuild." },
          { step: "04", title: "Monitor", desc: "Track rankings, AI citations, and answer placement weekly. Adapt to algorithm and model updates." },
        ].map((item, i) => (
          <div data-reveal="scale-in" data-delay={i * 150} class="group relative rounded-2xl border border-gray-200 bg-white p-6 transition-all duration-500 hover:shadow-xl hover:-translate-y-1 opacity-0">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-brand-400 to-rex-orange text-lg font-extrabold text-white shadow-lg">
              {item.step}
            </div>
            <h3 class="mb-2 font-display text-lg font-bold text-rex-dark">{item.title}</h3>
            <p class="text-sm text-gray-500">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section data-reveal="fade-up" class="border-t border-gray-200 bg-gradient-to-b from-gray-50 to-white py-24 opacity-0">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="mb-4 flex items-center justify-center gap-2 text-sm font-semibold uppercase tracking-[2px] text-brand-500">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        FAQ
