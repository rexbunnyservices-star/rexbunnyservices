---
import BaseLayout from "../layouts/BaseLayout.astro";
import MetricCard from "../components/MetricCard.tsx";
import LeadAuditTool from "../components/LeadAuditTool.tsx";
import FAQ from "../components/FAQ.tsx";
import CalEmbed from "../components/CalEmbed.tsx";

const faqs = [
  {
    question: "What's the difference between SEO, GEO, and AEO?",
    answer: "SEO optimizes for traditional search engines like Google. GEO (Generative Engine Optimization) gets your brand cited in AI responses from ChatGPT, Gemini, and Perplexity. AEO (Answer Engine Optimization) makes your content the direct answer — featured snippets, voice search, Siri, Alexa, and Google AI Overviews. Most businesses need all three to cover every way customers search.",
  },
  {
    question: "What is AEO and how is it different from GEO?",
    answer: "AEO (Answer Engine Optimization) focuses on making your content the direct answer that AI engines and voice assistants read aloud. Think featured snippets, 'position zero,' and Siri responses. GEO focuses on getting your brand cited as a source within AI responses. AEO = you ARE the answer. GEO = you're CITED in the answer. Both are essential in 2026.",
  },
  {
    question: "How do you measure AI search and answer visibility?",
    answer: "We run periodic queries across GPT-4o, Gemini 2.0, Perplexity, Copilot, Google AI Overviews, and voice assistants. We track whether your brand appears, in what position, and in what context — and whether your content is extracted as the direct answer. We also monitor GPTBot crawl behavior and entity presence in knowledge graphs.",
  },
  {
    question: "How long until I see results?",
    answer: "SEO results typically show in 4-12 weeks. Initial AI citations (GEO) appear within 4-8 weeks. AEO results — featured snippets and direct answers — can appear in as little as 2-4 weeks with proper schema and content structuring. Full authority across all channels builds over 3-6 months.",
  },
  {
    question: "Can you optimize my existing site or do I need a rebuild?",
    answer: "We can optimize your existing site — most SEO, GEO, and AEO improvements are about structured data, content restructuring, and entity signals. Web development is only needed if your site has severe performance issues (Lighthouse < 50, 5+ second load times).",
  },
  {
    question: "Do you offer web development as a standalone service?",
    answer: "Yes. While our core marketing services are SEO, GEO, and AEO, we also offer web development for clients who need a high-performance site built from the ground up — Lighthouse 95+, sub-second load times, edge-deployed, and LLM-ready. It can be bundled with our marketing services or purchased separately.",
  },
  {
    question: "What's included in the free audit?",
    answer: "The audit checks your Lighthouse performance scores (LCP, CLS, TBT), AI crawlability (GPTBot access, llms.txt presence), structured data quality (JSON-LD completeness), featured snippet presence, and produces a composite Search Visibility Score across all channels. A full PDF report with recommendations is emailed to you.",
  },
];

const siteUrl = "https://rexbunnyservices.online";
---

<BaseLayout
  title="Marketing Agency for AI & Search | SEO, GEO & AEO"
  description="REX Bunny Services is a marketing agency specializing in SEO, Generative Engine Optimization (GEO), and Answer Engine Optimization (AEO). We make your brand visible in every search — Google, ChatGPT, Gemini, Siri, and beyond."
>
  <!-- Hero -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  })} />
  <section class="relative overflow-hidden pt-24">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-950/20 to-dark-950" />
    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="mb-6 text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
          The Marketing Agency That Makes You{" "}
          <span class="bg-gradient-to-r from-brand-400 to-orange-400 bg-clip-text text-transparent">
            Visible in Every Search
          </span>
        </h1>
        <p class="mb-4 text-lg text-dark-300 sm:text-xl">
          SEO. GEO. AEO. We cover every way your customers search — Google, ChatGPT, Siri, Alexa, Gemini, and Perplexity.
        </p>
        <p class="mb-8 text-base text-dark-400">
          We're a marketing agency that engineers your brand into traditional search results, AI citations, 
          and direct answer engines — so you're found everywhere your customers are looking.
        </p>
        <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a
            href="/lead-engine"
            class="rounded-lg bg-brand-600 px-8 py-4 text-base font-semibold text-white transition-all hover:bg-brand-500 hover:shadow-lg hover:shadow-brand-500/25"
          >
            Run Your Free AI Visibility Audit →
          </a>
          <CalEmbed buttonText="Book a Strategy Call" client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- Value Metrics -->
  <section class="border-y border-dark-800 bg-dark-900/50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mb-8 text-center text-sm font-semibold uppercase tracking-widest text-dark-400">
        A Marketing Agency Built for the AI Era
      </p>
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
        <MetricCard value="0.3s" label="Avg LCP" description="Largest Contentful Paint" />
        <MetricCard value="98" label="Lighthouse" description="Performance Score" />
        <MetricCard value="100%" label="Schema Score" description="Structured Data Depth" />
        <MetricCard value="4-8 wk" label="to AI Cite" description="First LLM Citation" />
      </div>
    </div>
  </section>

  <!-- Five Service Pillars -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-4 text-center text-3xl font-bold text-white">Five Ways We Make You Visible</h2>
      <p class="mb-12 text-center text-dark-400">Every channel your customers search — we make sure you're there.</p>
      <div class="grid gap-6 md:grid-cols-5">
        <a href="/services/seo" class="group rounded-xl border border-dark-800 bg-dark-900 p-6 transition-all hover:border-brand-500/50 hover:shadow-lg hover:shadow-brand-500/10">
          <div class="mb-4 text-3xl">🔍</div>
          <h3 class="mb-2 text-lg font-bold text-white group-hover:text-brand-400">SEO</h3>
          <p class="mb-3 text-xs text-dark-500">Traditional & Local Search</p>
          <ul class="space-y-1 text-sm text-dark-400">
            <li>Technical & on-page SEO</li>
            <li>Programmatic local schema</li>
            <li>500+ city page automation</li>
            <li>GSC rank tracking</li>
          </ul>
        </a>
        <a href="/services/ai-search-optimization" class="group rounded-xl border border-dark-800 bg-dark-900 p-6 transition-all hover:border-brand-500/50 hover:shadow-lg hover:shadow-brand-500/10">
          <div class="mb-4 text-3xl">🤖</div>
          <h3 class="mb-2 text-lg font-bold text-white group-hover:text-brand-400">GEO</h3>
          <p class="mb-3 text-xs text-dark-500">Generative Engine Optimization</p>
          <ul class="space-y-1 text-sm text-dark-400">
            <li>Entity engineering for AI</li>
            <li>LLM citation optimization</li>
            <li>AI crawl strategy</li>
            <li>Source score boosting</li>
          </ul>
        </a>
        <a href="/services/aeo" class="group rounded-xl border border-brand-500/30 bg-dark-900 p-6 transition-all hover:border-brand-500 hover:shadow-lg hover:shadow-brand-500/10">
          <div class="mb-4 text-3xl">🎙️</div>
          <h3 class="mb-2 text-lg font-bold text-brand-400">AEO</h3>
          <p class="mb-3 text-xs text-dark-500">Answer Engine Optimization</p>
          <ul class="space-y-1 text-sm text-dark-400">
            <li>Featured snippet capture</li>
            <li>Voice & assistant readiness</li>
            <li>AI Overview integration</li>
            <li>Direct answer engineering</li>
          </ul>
          <div class="mt-4 text-xs font-semibold text-brand-500">★ New Service</div>
        </a>
        <a href="/services/web-development" class="group rounded-xl border border-dark-800 bg-dark-900 p-6 transition-all hover:border-brand-500/50 hover:shadow-lg hover:shadow-brand-500/10">
          <div class="mb-4 text-3xl">🚀</div>
          <h3 class="mb-2 text-lg font-bold text-white group-hover:text-brand-400">Web Dev</h3>
          <p class="mb-3 text-xs text-dark-500">Built for Search Performance</p>
          <ul class="space-y-1 text-sm text-dark-400">
            <li>Lighthouse 95+ guaranteed</li>
            <li>Sub-second load times</li>
            <li>LLM-crawlable HTML</li>
            <li>Edge-deployed architecture</li>
          </ul>
        </a>
        <a href="/services/ai-visual" class="group rounded-xl border border-dark-800 bg-dark-900 p-6 transition-all hover:border-brand-500/50 hover:shadow-lg hover:shadow-brand-500/10">
          <div class="mb-4 text-3xl">🎨</div>
          <h3 class="mb-2 text-lg font-bold text-white group-hover:text-brand-400">AI Visual</h3>
          <p class="mb-3 text-xs text-dark-500">AI-Generated Visual Content</p>
          <ul class="space-y-1 text-sm text-dark-400">
            <li>Social graphics & video ads</li>
            <li>Product imagery & brand kits</li>
            <li>AI headshots & 3D mockups</li>
            <li>Delivered in days, not weeks</li>
          </ul>
        </a>
      </div>
    </div>
  </section>

  <!-- Social Proof: Testimonials -->
  <section class="border-y border-dark-800 bg-dark-900/50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-4 text-center text-3xl font-bold text-white">Results That Speak</h2>
      <p class="mb-12 text-center text-dark-400">Real outcomes from real clients.</p>
      <div class="grid gap-6 md:grid-cols-3">
        {
          [
            {
              quote: "REX Bunny didn't just rebuild our site — they rebuilt our business. The performance gains translated directly to revenue.",
              author: "Sarah Chen",
              role: "CTO, CloudMetrics",
              metric: "+96% conversions",
            },
            {
              quote: "We went from invisible in local search to dominating every market we serve. The ROI was evident within the first quarter.",
              author: "Dr. James Park",
              role: "Founder, BrightSmile Dental",
              metric: "+312% traffic",
            },
            {
              quote: "Our products now show up when people ask AI about home furniture. That's a completely new channel we never had before.",
              author: "Erik Lindqvist",
              role: "CEO, Nordic Home Co.",
              metric: "23 AI citations/mo",
            },
          ].map((t) => (
            <div class="rounded-xl border border-dark-800 bg-dark-900 p-6">
              <div class="mb-4 text-2xl font-bold text-brand-400">{t.metric}</div>
              <p class="mb-4 text-sm text-dark-300 italic">"{t.quote}"</p>
              <div>
                <div class="text-sm font-semibold text-white">{t.author}</div>
                <div class="text-xs text-dark-500">{t.role}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Client Logos Bar -->
  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mb-8 text-center text-sm font-semibold uppercase tracking-widest text-dark-500">
        Trusted by forward-thinking brands
      </p>
      <div class="flex flex-wrap items-center justify-center gap-8 opacity-50">
        {["CloudMetrics", "BrightSmile Dental", "Nordic Home Co.", "TechVault", "ScaleUp Labs"].map((name) => (
          <div class="rounded-lg border border-dark-800 bg-dark-900 px-6 py-3 text-sm font-medium text-dark-400">
            {name}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Case Study Carousel -->
  <section class="border-y border-dark-800 bg-dark-900/50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 flex items-end justify-between">
        <div>
          <h2 class="mb-2 text-3xl font-bold text-white">Proven Results</h2>
          <p class="text-dark-400">Real outcomes from real clients. Every metric verified.</p>
        </div>
        <a href="/portfolio" class="hidden text-sm font-semibold text-brand-400 hover:text-brand-300 sm:block">
          View All Case Studies →
        </a>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {
          [
            {
              title: "SaaS Platform Rebuild",
              client: "CloudMetrics",
              service: "Web Development",
              desc: "From 6s to 0.4s LCP. Complete platform rebuild using Astro + Preact Islands.",
              metrics: [
                { label: "Lighthouse", value: "98" },
                { label: "Traffic", value: "+142%" },
                { label: "Conversions", value: "+96%" },
              ],
              color: "text-blue-400",
              slug: "saas-platform-rebuild",
            },
            {
              title: "Dental Chain Local SEO",
              client: "BrightSmile Dental",
              service: "SEO",
              desc: "120+ city pages with automated schema. Programmatic local SEO at scale.",
              metrics: [
                { label: "Lighthouse", value: "96" },
                { label: "Traffic", value: "+312%" },
                { label: "LCP", value: "0.6s" },
              ],
              color: "text-green-400",
              slug: "dental-chain-local-seo",
            },
            {
              title: "E-Commerce AI Visibility",
              client: "Nordic Home Co.",
              service: "AI Search Optimization",
              desc: "GEO optimization that got a brand cited in ChatGPT, Perplexity, and Gemini.",
              metrics: [
                { label: "Lighthouse", value: "97" },
                { label: "Traffic", value: "+89%" },
                { label: "Conversions", value: "+45%" },
              ],
              color: "text-purple-400",
              slug: "ecommerce-ai-visibility",
            },
          ].map((cs) => (
            <a
              href={`/portfolio/${cs.slug}`}
              class="group rounded-xl border border-dark-800 bg-dark-900 p-6 transition-all hover:border-brand-500/50 hover:shadow-lg hover:shadow-brand-500/10"
            >
              <div class={`mb-3 text-xs font-semibold ${cs.color}`}>
                {cs.service.toUpperCase()}
              </div>
              <h3 class="mb-1 text-lg font-bold text-white group-hover:text-brand-400">
                {cs.title}
              </h3>
              <p class="mb-1 text-xs text-dark-500">{cs.client}</p>
              <p class="mb-4 text-sm text-dark-400">{cs.desc}</p>
              <div class="flex flex-wrap gap-2">
                {cs.metrics.map((m) => (
                  <span class="rounded bg-dark-800 px-2 py-1 text-xs text-dark-300">
                    <span class="font-semibold text-white">{m.value}</span> {m.label}
                  </span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a href="/portfolio" class="text-sm font-semibold text-brand-400 hover:text-brand-300">
          View All Case Studies →
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 flex items-end justify-between">
        <div>
          <h2 class="mb-2 text-3xl font-bold text-white">From the Blog</h2>
          <p class="text-dark-400">GEO strategies, SEO tactics, and web performance guides.</p>
        </div>
        <a href="/blog" class="hidden text-sm font-semibold text-brand-400 hover:text-brand-300 sm:block">
          View All Posts →
        </a>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {
          [
            {
              title: "How to Get Your Brand Cited in ChatGPT",
              date: "June 22, 2026",
              desc: "Step-by-step guide to optimizing your website so ChatGPT recommends your brand.",
              tags: ["GEO", "ChatGPT"],
              slug: "get-cited-in-chatgpt",
            },
            {
              title: "What is Generative Engine Optimization (GEO)?",
              date: "June 15, 2026",
              desc: "A complete guide to optimizing your website for AI search engines.",
              tags: ["GEO", "AI Search"],
              slug: "what-is-geo",
            },
            {
              title: "llms.txt Explained: The File Every Website Needs",
              date: "May 28, 2026",
              desc: "What is llms.txt, why it matters, and how to create one in under 10 minutes.",
              tags: ["Technical", "AI Search"],
              slug: "llms-txt-explained",
            },
          ].map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="group rounded-xl border border-dark-800 bg-dark-900 p-6 transition-all hover:border-brand-500/50 hover:shadow-lg hover:shadow-brand-500/10"
            >
              <div class="mb-2 text-xs text-dark-500">{post.date}</div>
              <h3 class="mb-2 text-lg font-bold text-white group-hover:text-brand-400">
                {post.title}
              </h3>
              <p class="mb-4 text-sm text-dark-400">{post.desc}</p>
              <div class="flex flex-wrap gap-2">
                {post.tags.map((tag) => (
                  <span class="rounded bg-dark-800 px-2 py-1 text-xs text-dark-400">{tag}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a href="/blog" class="text-sm font-semibold text-brand-400 hover:text-brand-300">
          View All Posts →
        </a>
      </div>
    </div>
  </section>

  <!-- Lead Engine Embed -->
  <section class="bg-dark-900/50 py-20" id="audit">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-2 text-center text-3xl font-bold text-white">Is Your Site Ready for AI Search?</h2>
      <p class="mb-8 text-center text-dark-400">Find out in 30 seconds. Free audit, no credit card.</p>
      <LeadAuditTool client:visible />
      <p class="mt-4 text-center text-xs text-dark-500">
        We'll check: Lighthouse Performance, AI Crawlability, Structured Data Quality, and LLM Citation Potential.
      </p>
    </div>
  </section>

  <!-- Process -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-12 text-center text-3xl font-bold text-white">The REX Bunny Marketing Blueprint</h2>
      <div class="grid gap-4 md:grid-cols-4">
        {[
          { step: "01", title: "Audit", desc: "Full diagnostic — SEO health, AI crawlability, entity presence, answer extraction potential." },
          { step: "02", title: "Strategize", desc: "Build a unified plan across SEO, GEO, and AEO. Identify gaps in every search channel." },
          { step: "03", title: "Implement", desc: "Execute the strategy — technical SEO, entity engineering, answer optimization, or performance rebuild." },
          { step: "04", title: "Monitor", desc: "Track rankings, AI citations, and answer placement weekly. Adapt to algorithm and model updates." },
        ].map((item) => (
          <div class="rounded-xl border border-dark-800 bg-dark-900 p-6">
            <div class="mb-3 text-sm font-bold text-brand-500">{item.step}</div>
            <h3 class="mb-2 text-lg font-bold text-white">{item.title}</h3>
            <p class="text-sm text-dark-400">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-dark-900/50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-center text-3xl font-bold text-white">Questions We Hear Every Day</h2>
      <FAQ items={faqs} client:visible />
      <div class="mt-8 text-center">
        <CalEmbed buttonText="Still have questions? Book a Free 30-min Call →" />
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="mb-4 text-3xl font-bold text-white">
        Most businesses are invisible in at least one search channel — and don't know it.
      </h2>
      <p class="mb-8 text-dark-400">Run your free audit. See your visibility across SEO, AI citations, and direct answers.</p>
      <a
        href="/lead-engine"
        class="inline-block rounded-lg bg-brand-600 px-8 py-4 text-base font-semibold text-white transition-all hover:bg-brand-500 hover:shadow-lg hover:shadow-brand-500/25"
      >
        Run Your Free Visibility Audit →
      </a>
    </div>
  </section>
</BaseLayout>
