      <div class="mt-8 text-center">
        <CalEmbed buttonText="Still have questions? Book a Free 30-min Call →" />
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section data-reveal="scale-in" class="relative overflow-hidden py-24 opacity-0">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-900 via-rex-dark to-brand-950" />
    <div class="absolute inset-0 bg-brand-glow opacity-20 animate-ping-slow" />
    <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <div class="mb-4 inline-flex items-center rounded-full border border-brand-700/50 bg-brand-800/30 px-4 py-1.5 text-sm font-medium text-brand-300">
        Start Your Journey
      </div>
      <h2 class="mb-4 font-display text-4xl font-extrabold text-white sm:text-5xl">
        Most businesses are invisible in at least one search channel — and don't know it.
      </h2>
      <p class="mb-10 text-lg text-brand-200/80">Run your free audit. See your visibility across SEO, AI citations, and direct answers.</p>
      <a
        href="/lead-engine"
        data-magnetic
        class="relative inline-block overflow-hidden rounded-xl bg-gradient-to-r from-brand-400 to-rex-orange px-10 py-4 text-lg font-bold text-white shadow-2xl shadow-brand-500/40 transition-all hover:shadow-[0_0_40px_rgba(249,115,22,0.4)] hover:-translate-y-0.5"
      >
        <span class="absolute inset-0 bg-[length:200%_100%] bg-gradient-to-r from-transparent via-white/20 to-transparent animate-shimmer" />
        <span class="relative">Run Your Free Visibility Audit →</span>
      </a>
    </div>
  </section>
</BaseLayout>
