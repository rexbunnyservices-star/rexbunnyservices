---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalEmbed from '../../components/CalEmbed.tsx';
import { getCollection } from 'astro:content';

const projects = await getCollection('portfolio');

const serviceColors: Record<string, string> = {
  'Web Development': 'text-blue-400',
  SEO: 'text-green-400',
  'AI Search Optimization': 'text-purple-400',
};
---

<BaseLayout
  title="Portfolio"
  description="Sample builds from RexBunny Services — examples of web performance, SEO, and AI search optimization work."
>
  <section class="pt-24">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <h1 class="mb-4 text-center text-4xl font-extrabold text-gray-900 sm:text-5xl">
        Example Projects
      </h1>
      <p class="mb-8 text-center text-lg text-gray-500">
        Sample builds showing scope, architecture and technical results.
      </p>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project) => (
            <a
              href={`/portfolio/${project.id}`}
              class="group rounded-xl border border-gray-200 bg-white p-6 transition-all hover:shadow-md hover:border-gray-300"
            >
              <div class="mb-4 flex h-40 items-center justify-center rounded-lg bg-gray-100">
                <span class="text-4xl text-gray-400">
                  {project.data.serviceType === 'Web Development' && '⚡'}
                  {project.data.serviceType === 'SEO' && '📈'}
                  {project.data.serviceType === 'AI Search Optimization' && '🤖'}
                </span>
              </div>
              <div
                class={`mb-2 text-xs font-semibold ${
                  serviceColors[project.data.serviceType] || 'text-brand-500'
                }`}
              >
                {project.data.serviceType.toUpperCase()}
              </div>
              <h3 class="mb-2 text-lg font-bold text-gray-900 group-hover:text-brand-600">
                {project.data.title}
              </h3>
              <p class="mb-4 text-sm text-gray-500">{project.data.description}</p>
              <div class="flex flex-wrap gap-2 text-xs text-gray-400">
                {project.data.results.lighthouse && (
                  <span class="rounded bg-gray-100 px-2 py-1">
                    Lighthouse: {project.data.results.lighthouse}
                  </span>
                )}
                {project.data.results.lcp && (
                  <span class="rounded bg-gray-100 px-2 py-1">LCP: {project.data.results.lcp}</span>
                )}
              </div>
            </a>
          ))
        }
      </div>
      <div class="mt-12 text-center">
        <CalEmbed buttonText="Start Your Project →" />
      </div>
    </div>
  </section>
</BaseLayout>
