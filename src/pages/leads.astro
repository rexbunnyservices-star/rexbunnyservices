---
import BaseLayout from "../layouts/BaseLayout.astro";
import LeadsDashboard from "../components/LeadsDashboard.tsx";
---

<BaseLayout title="Leads Dashboard | REX Bunny Services" description="View and manage all website form submissions.">
  <section class="pt-24">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="mb-4 text-4xl font-extrabold text-white sm:text-5xl">
          <span class="text-brand-400">Leads</span> Dashboard
        </h1>
        <p class="mb-8 text-lg text-dark-300">
          View and manage all form submissions from your website visitors.
        </p>
      </div>

      <div class="mx-auto max-w-6xl">
        <LeadsDashboard client:load />
      </div>
    </div>
  </section>
</BaseLayout>
