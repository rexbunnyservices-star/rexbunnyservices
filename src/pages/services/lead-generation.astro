---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalEmbed from '../../components/CalEmbed.tsx';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Lead Generation',
  description:
    'A retargeted lead engine that scrapes freelance job boards, hiring posts, and social signals, then scores intent and enriches contacts — so you follow up on buyers, not looky-loos.',
  provider: {
    '@type': 'Organization',
    name: 'RexBunny Services',
    url: 'https://rexbunnyservices.online',
  },
  serviceType: 'Lead Generation',
  areaServed: { '@type': 'Country', name: 'Canada' },
  url: 'https://rexbunnyservices.online/services/lead-generation',
};

const benefits = [
  {
    metric: '24/7',
    label: 'Multi-source scraping',
    desc: 'Job boards, hiring posts & social signals',
  },
  {
    metric: 'AI-scored',
    label: 'Buyer intent model',
    desc: 'Clients surfaced, providers filtered',
  },
  { metric: 'Verified', label: 'Contacts enriched', desc: 'Emails, profiles & handles extracted' },
];

const stackItems = [
  {
    name: 'Freelance boards',
    desc: 'Remotive, RemoteOK, Himalayas, We Work Remotely — JSON/HTML, no login',
  },
  { name: 'Social signals', desc: 'X, Instagram, Facebook, LinkedIn — hiring language targeted' },
  {
    name: 'Intent scoring',
    desc: 'Tiered buyer-intent rules gate every lead before it reaches you',
  },
  { name: 'Contact extraction', desc: 'Email, phone, profile handles normalized into one record' },
  {
    name: 'PocketBase CRM',
    desc: 'Every lead lands in a queryable collection with source + status',
  },
  {
    name: 'Live dashboard',
    desc: 'Browse, filter and export leads instead of digging through threads',
  },
];
---

<BaseLayout
  title="Lead Generation"
  description="A lead engine that finds, scores, and enriches freelance job and hiring leads daily. Reach potential clients with verified contacts and AI-scored buyer intent."
  breadcrumbs={[
    { name: 'Services', url: '/services' },
    { name: 'Lead Generation', url: '/services/lead-generation' },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <!-- Hero -->
  <section class="pt-24">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="mb-6 text-4xl font-extrabold text-gray-900 sm:text-5xl">
          A Lead Engine That Finds <span class="text-brand-600">Buyers</span>, Not Just Leads
        </h1>
        <p class="mb-8 text-lg text-gray-600">
          We scrape freelance job boards, hiring posts, and social signals around the clock — then
          score every hit for genuine buyer intent and enrich the contact details, so your outreach
          list is full of people who actually want to pay for web work.
        </p>
        <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a
            href="/contact"
            class="rounded-lg bg-brand-600 px-8 py-4 font-semibold text-white hover:bg-brand-500"
          >
            Get a Sample of Your Leads →
          </a>
          <CalEmbed buttonText="Book a Strategy Call" />
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="border-y border-gray-200 bg-gray-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
        {
          benefits.map((b) => (
            <div class="rounded-xl border border-gray-200 bg-white p-6 text-center">
              <div class="text-3xl font-bold text-brand-600">{b.metric}</div>
              <div class="mt-2 text-sm font-medium text-gray-900">{b.label}</div>
              <div class="mt-1 text-xs text-gray-500">{b.desc}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Sources -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-2 text-center text-3xl font-bold text-gray-900">Where We Hunt</h2>
      <p class="mb-12 text-center text-gray-500">
        Every source feeds one pipeline, so nothing gets lost in a different tab.
      </p>
      <div class="grid gap-4 md:grid-cols-3">
        {
          stackItems.map((item) => (
            <div class="rounded-xl border border-gray-200 bg-white p-6">
              <h3 class="mb-2 text-lg font-bold text-gray-900">{item.name}</h3>
              <p class="text-sm text-gray-500">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-gray-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-12 text-center text-3xl font-bold text-gray-900">How the Pipeline Runs</h2>
      <div class="grid gap-4 md:grid-cols-4">
        {
          [
            {
              step: '1',
              title: 'Scrape',
              desc: 'Boards and social feeds are checked on schedule. Fresh hiring posts and freelance asks are captured with their links.',
            },
            {
              step: '2',
              title: 'Score',
              desc: 'Every post is classified by intent — buyer vs provider vs noise. Only genuine hiring language makes the cut.',
            },
            {
              step: '3',
              title: 'Enrich',
              desc: 'Contacts and profiles are extracted and normalized: email, handle, platform, and a link straight to the post.',
            },
            {
              step: '4',
              title: 'Deliver',
              desc: 'Leads land in your CRM with source, status and score, ready for outreach the same day.',
            },
          ].map((item) => (
            <div class="rounded-xl border border-gray-200 bg-white p-6">
              <div class="mb-3 text-sm font-bold text-brand-500">Step {item.step}</div>
              <h3 class="mb-2 text-lg font-bold text-gray-900">{item.title}</h3>
              <p class="text-sm text-gray-500">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="mb-4 text-3xl font-bold text-gray-900">
        Ready for a Constant Stream of Real Prospects?
      </h2>
      <p class="mb-8 text-gray-500">
        See a sample of your niche's live hiring demand before you commit to anything.
      </p>
      <a
        href="/contact"
        class="inline-block rounded-lg bg-brand-600 px-8 py-4 font-semibold text-white hover:bg-brand-500"
      >
        Get Your Sample List →
      </a>
    </div>
  </section>

  <!-- Related Reading -->
  <section class="border-t border-gray-200 py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h3 class="mb-6 text-center text-sm font-semibold uppercase tracking-wider text-gray-500">
        Related Reading
      </h3>
      <div class="grid gap-4 sm:grid-cols-2">
        <a
          href="/lead-engine"
          class="group rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-md hover:border-gray-300"
        >
          <div class="text-xs font-semibold text-violet-500">FREE AUDIT</div>
          <h4 class="mt-1 text-sm font-bold text-gray-900 group-hover:text-brand-600">
            Run the Lead Engine Free
          </h4>
          <p class="mt-1 text-xs text-gray-500">See your AI search visibility and lead potential</p>
        </a>
        <a
          href="/services/seo"
          class="group rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-md hover:border-gray-300"
        >
          <div class="text-xs font-semibold text-brand-600">SERVICE</div>
          <h4 class="mt-1 text-sm font-bold text-gray-900 group-hover:text-brand-600">
            AI Search Optimization
          </h4>
          <p class="mt-1 text-xs text-gray-500">Make buyers find you organically too</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
