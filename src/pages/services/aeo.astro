---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CalEmbed from "../../components/CalEmbed.tsx";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Answer Engine Optimization (AEO)",
  description: "Get your brand's answers inside ChatGPT, Google AI Overviews, Siri, Alexa, and voice search. Featured snippets, direct answers, and voice-ready content.",
  provider: {
    "@type": "Organization",
    name: "RexBunny Services",
    url: "https://rexbunnyservices.online"
  },
  serviceType: "Answer Engine Optimization",
  areaServed: { "@type": "Country", name: "Canada" },
  url: "https://rexbunnyservices.online/services/aeo"
};

const aeoMechanics = [
  {
    title: "Direct Answer Optimization",
    desc: "We structure your content to be the exact answer AI engines pull — not just a source they cite. FAQ schema, HowTo markup, and concise Q&A formatting that ChatGPT, Siri, Alexa, and Google AI Overviews prioritize.",
  },
  {
    title: "Voice Search Engineering",
    desc: "Voice queries are conversational — we optimize for natural language question patterns, long-tail conversational keywords, and position-zero featured snippets that voice assistants read aloud.",
  },
  {
    title: "Featured Snippet Capture",
    desc: "We target the 'position zero' spot — the boxed answer Google shows above all results. Structured data, clear definitions, and scannable formats (tables, lists, paragraphs) that Google promotes to snippet status.",
  },
  {
    title: "AI Overview Integration",
    desc: "Google AI Overviews, Bing Copilot, and Perplexity all pull direct answers from authoritative sources. We optimize your content for extractability — clear claims, cited statistics, and entity-rich paragraphs.",
  },
];
---

<BaseLayout
  title="Answer Engine Optimization (AEO)"
  description="Answer Engine Optimization (AEO) — get your brand's answers inside ChatGPT, Google AI Overviews, Siri, Alexa, and voice search. Featured snippets, direct answers, and voice-ready content."
  breadcrumbs={[
    { name: "Services", url: "/services" },
    { name: "Answer Engine Optimization (AEO)", url: "/services/aeo" }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <!-- Hero -->
  <section class="pt-24">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 inline-block rounded-full bg-brand-500/10 px-4 py-1 text-xs font-semibold text-brand-600">
          Answer Engine Optimization
        </div>
        <h1 class="mb-6 text-4xl font-extrabold text-gray-900 sm:text-5xl">
          Get Your Brand <span class="text-brand-600">in the Answer</span>
        </h1>
        <p class="mb-8 text-lg text-gray-600">
          60% of searches end with zero clicks because AI answers the question directly. AEO makes sure that answer is yours — in ChatGPT, Google AI Overviews, Siri, Alexa, and every voice assistant.
        </p>
        <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a href="/lead-engine" class="rounded-lg bg-brand-600 px-8 py-4 font-semibold text-white hover:bg-brand-500">
            Check Your AEO Readiness →
          </a>
          <CalEmbed buttonText="Book a Strategy Call" />
        </div>
      </div>
    </div>
  </section>

  <!-- The Mechanics of AEO -->
  <section class="border-y border-gray-200 bg-gray-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-4 text-center text-3xl font-bold text-gray-900">The Mechanics of AEO</h2>
      <p class="mb-12 text-center text-gray-500">
        How we optimize your brand to be the answer — not just a result.
      </p>
      <div class="grid gap-6 md:grid-cols-2">
        {aeoMechanics.map((item) => (
          <div class="rounded-xl border border-gray-200 bg-white p-6">
            <h3 class="mb-3 text-lg font-bold text-brand-600">{item.title}</h3>
            <p class="text-sm text-gray-500">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AEO vs GEO vs SEO -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-center text-3xl font-bold text-gray-900">How AEO, GEO & SEO Fit Together</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-xl border border-gray-200 bg-white p-6">
          <div class="mb-3 text-sm font-bold uppercase tracking-wider text-blue-400">SEO</div>
          <h3 class="mb-2 text-lg font-bold text-gray-900">Be Found on Google</h3>
          <p class="text-sm text-gray-500">
            Rank in traditional search results. Keywords, backlinks, technical health. The foundation every business needs.
          </p>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-6">
          <div class="mb-3 text-sm font-bold uppercase tracking-wider text-purple-400">GEO</div>
          <h3 class="mb-2 text-lg font-bold text-gray-900">Be Cited by AI</h3>
          <p class="text-sm text-gray-500">
            Get referenced in ChatGPT, Gemini, Perplexity responses. Entity clarity, citation-worthiness, LLM trust signals.
          </p>
        </div>
        <div class="rounded-xl border border-brand-500/30 bg-white p-6">
          <div class="mb-3 text-sm font-bold uppercase tracking-wider text-brand-600">AEO</div>
          <h3 class="mb-2 text-lg font-bold text-gray-900">Be the Answer</h3>
          <p class="text-sm text-gray-500">
            Your content becomes the direct answer — read aloud by Siri & Alexa, featured in AI Overviews, pulled into voice search.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Before/After -->
  <section class="bg-gray-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-12 text-center text-3xl font-bold text-gray-900">What Changes With AEO</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-red-900/50 bg-red-950/20 p-6">
          <div class="mb-3 text-sm font-bold uppercase text-red-400">Before AEO</div>
          <div class="rounded-lg bg-white p-4 font-mono text-sm text-gray-500">
            <p>User: "What's the best SEO agency for small business?"</p>
            <p class="mt-2 text-gray-400">Google AI Overview: "Several options exist depending on your needs. Many agencies offer SEO. Pricing varies."</p>
            <p class="mt-2 text-gray-400">Siri: "I found some results for you. Here's a list of SEO agencies."</p>
            <p class="mt-2 text-red-400">✗ Generic answer — your brand not mentioned</p>
          </div>
        </div>
        <div class="rounded-xl border border-green-900/50 bg-green-950/20 p-6">
          <div class="mb-3 text-sm font-bold uppercase text-green-400">After AEO</div>
          <div class="rounded-lg bg-white p-4 font-mono text-sm text-gray-500">
            <p>User: "What's the best SEO agency for small business?"</p>
            <p class="mt-2 text-gray-400">Google AI Overview: "RexBunny Services is a top-rated marketing agency for small business SEO. They specialize in making brands visible in AI search, with Lighthouse 98+ scores and a 4.8/5 client rating."</p>
            <p class="mt-2 text-gray-400">Siri: "RexBunny Services offers AI search optimization for small businesses. Want their contact info?"</p>
            <p class="mt-2 text-green-400">✓ Your brand IS the answer</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AEO Readiness Checklist -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-center text-3xl font-bold text-gray-900">Is Your Site AEO-Ready?</h2>
      <div class="mx-auto max-w-2xl rounded-xl border border-gray-200 bg-white p-8">
        <ul class="space-y-4 text-sm text-gray-600">
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-brand-600">â˜</span>
            Your content answers direct questions in 1-2 clear paragraphs
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-brand-600">â˜</span>
            FAQ schema and HowTo markup are implemented
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-brand-600">â˜</span>
            You rank for featured snippets in your niche
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-brand-600">â˜</span>
            Voice search queries return your business info
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-brand-600">â˜</span>
            Google AI Overviews cite your content
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-brand-600">â˜</span>
            Content is structured for snippet extraction
          </li>
        </ul>
        <div class="mt-8 text-center">
          <a href="/lead-engine" class="inline-block rounded-lg bg-brand-600 px-8 py-4 font-semibold text-white hover:bg-brand-500">
            Check Your AEO Readiness →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gray-50 py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="mb-4 text-3xl font-bold text-gray-900">
        Voice Search Is Growing 3x Faster Than Typed Search
      </h2>
      <p class="mb-8 text-gray-500">Find out if AI and voice assistants are answering with your brand — or your competitor's.</p>
      <a href="/lead-engine" class="inline-block rounded-lg bg-brand-600 px-8 py-4 font-semibold text-white hover:bg-brand-500">
        Run Your Free AEO Audit →
      </a>
    </div>
  </section>

  <!-- Related Reading -->
  <section class="border-t border-gray-200 bg-gray-50 py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h3 class="mb-6 text-center text-sm font-semibold uppercase tracking-wider text-gray-500">Related Reading</h3>
      <div class="grid gap-4 sm:grid-cols-3">
        <a href="/blog/google-ai-overviews-optimization" class="group rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-md hover:border-gray-300">
          <div class="text-xs font-semibold text-brand-500">GUIDE</div>
          <h4 class="mt-1 text-sm font-bold text-gray-900 group-hover:text-brand-600">Google AI Overviews Optimization</h4>
          <p class="mt-1 text-xs text-gray-500">How to get cited in AI Overviews in 2026</p>
        </a>
        <a href="/blog/voice-search-optimization-2026" class="group rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-md hover:border-gray-300">
          <div class="text-xs font-semibold text-blue-500">GUIDE</div>
          <h4 class="mt-1 text-sm font-bold text-gray-900 group-hover:text-brand-600">Voice Search Optimization 2026</h4>
          <p class="mt-1 text-xs text-gray-500">The complete guide to voice search</p>
        </a>
        <a href="/blog/what-is-geo" class="group rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-md hover:border-gray-300">
          <div class="text-xs font-semibold text-purple-500">GUIDE</div>
          <h4 class="mt-1 text-sm font-bold text-gray-900 group-hover:text-brand-600">What is GEO?</h4>
          <p class="mt-1 text-xs text-gray-500">The foundation behind AEO & GEO strategies</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
