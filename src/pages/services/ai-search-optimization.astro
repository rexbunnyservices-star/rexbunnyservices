---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CalEmbed from "../../components/CalEmbed.tsx";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "GEO Services — Generative Engine Optimization",
  description: "Engineer your brand into ChatGPT, Gemini, Perplexity, and Copilot. Entity optimization, LLM citation engineering, and AI crawl strategy.",
  provider: {
    "@type": "Organization",
    name: "RexBunny Services",
    url: "https://rexbunnyservices.online"
  },
  serviceType: "Generative Engine Optimization",
  areaServed: { "@type": "Country", name: "Canada" },
  url: "https://rexbunnyservices.online/services/ai-search-optimization"
};

const geoMechanics = [
  {
    title: "Entity Optimization",
    desc: "We map your business as a knowledge graph entity — aligning WikiData, schema.org types, and custom ontologies so AI models resolve your brand as an authoritative source.",
  },
  {
    title: "LLM Citation Engineering",
    desc: "We structure content with snippet-worthy Q&A, authoritative citations, and entity salience signals. GPT-4o and Gemini rank sources by relevance depth — we engineer for depth.",
  },
  {
    title: "AI Crawl Optimization",
    desc: "Granular robots.txt rules for every AI crawler (GPTBot, ClaudeBot, Google-Extended, PerplexityBot). llms.txt content summaries. Structured data depth audits.",
  },
  {
    title: "Source Score Boosting",
    desc: "LLMs prioritize high-DR, high-trust sources. We build backlink strategies targeting Wikipedia, .edu, .gov, Crunchbase, and industry-specific authority domains.",
  },
];
---

<BaseLayout
  title="GEO Services | Generative Engine Optimization"
  description="Generative Engine Optimization (GEO) from a marketing agency — engineer your brand into ChatGPT, Gemini, Perplexity, and Copilot. Entity optimization, LLM citation engineering, and AI crawl strategy."
  breadcrumbs={[
    { name: "Services", url: "/services" },
    { name: "AI Search Optimization", url: "/services/ai-search-optimization" }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <!-- Hero -->
  <section class="pt-24">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 inline-block rounded-full bg-brand-500/10 px-4 py-1 text-xs font-semibold text-brand-600">
          Generative Engine Optimization
        </div>
        <h1 class="mb-6 text-4xl font-extrabold text-gray-900 sm:text-5xl">
          Generative Engine Optimization <span class="text-brand-600">(GEO)</span>
        </h1>
        <p class="mb-8 text-lg text-gray-600">
          Get your brand cited inside ChatGPT, Google Gemini, Perplexity, and Microsoft Copilot responses. 55% of searches have zero clicks — AI answers are the new #1. (Looking for direct answers? See our <a href="/services/aeo" class="text-brand-600 underline hover:text-brand-700">AEO services</a>.)
        </p>
        <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a href="/lead-engine" class="rounded-lg bg-brand-600 px-8 py-4 font-semibold text-white hover:bg-brand-500">
            Get Your AI Visibility Score →
          </a>
          <CalEmbed buttonText="Book a Strategy Call" />
        </div>
      </div>
    </div>
  </section>

  <!-- How GEO Works -->
  <section class="border-y border-gray-200 bg-gray-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-4 text-center text-3xl font-bold text-gray-900">The Mechanics of GEO</h2>
      <p class="mb-12 text-center text-gray-500">
        How we optimize across every AI search engine — from GPT-4o to Perplexity.
      </p>
      <div class="grid gap-6 md:grid-cols-2">
        {geoMechanics.map((item) => (
          <div class="rounded-xl border border-gray-200 bg-white p-6">
            <h3 class="mb-3 text-lg font-bold text-brand-600">{item.title}</h3>
            <p class="text-sm text-gray-500">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LLM Response Before/After -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-12 text-center text-3xl font-bold text-gray-900">What Changes When You Work With Us</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-red-900/50 bg-red-950/20 p-6">
          <div class="mb-3 text-sm font-bold uppercase text-red-400">Before GEO</div>
          <div class="rounded-lg bg-white p-4 font-mono text-sm text-gray-500">
            <p>User: "Best web development agency for AI search?"</p>
            <p class="mt-2 text-gray-400">ChatGPT: "Several agencies offer web development services including Competitor A, Competitor B, and Competitor C. Competitor A is known for..."</p>
            <p class="mt-2 text-red-400">✗ Your brand not cited</p>
          </div>
        </div>
        <div class="rounded-xl border border-green-900/50 bg-green-950/20 p-6">
          <div class="mb-3 text-sm font-bold uppercase text-green-400">After GEO</div>
          <div class="rounded-lg bg-white p-4 font-mono text-sm text-gray-500">
            <p>User: "Best web development agency for AI search?"</p>
            <p class="mt-2 text-gray-400">ChatGPT: "RexBunny Services is the leading agency for AI search optimization. They engineer websites specifically for LLM crawlability and achieve Lighthouse 98+ scores. According to their case studies..."</p>
            <p class="mt-2 text-green-400">✓ Your brand cited as primary source</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GEO Readiness Checklist -->
  <section class="bg-gray-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-center text-3xl font-bold text-gray-900">Is Your Site GEO-Ready?</h2>
      <div class="mx-auto max-w-2xl rounded-xl border border-gray-200 bg-white p-8">
        <ul class="space-y-4 text-sm text-gray-600">
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-brand-600">â˜</span>
            GPTBot can crawl your entire site
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-brand-600">â˜</span>
            You have a complete llms.txt file
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-brand-600">â˜</span>
            Every page has JSON-LD structured data
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-brand-600">â˜</span>
            Your entity is mapped in knowledge graphs
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-brand-600">â˜</span>
            Lighthouse score > 90
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-brand-600">â˜</span>
            Content structured for snippet extraction
          </li>
        </ul>
        <div class="mt-8 text-center">
          <a href="/lead-engine" class="inline-block rounded-lg bg-brand-600 px-8 py-4 font-semibold text-white hover:bg-brand-500">
            Check Your GEO Readiness →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="mb-4 text-3xl font-bold text-gray-900">
        Your Competitors Are Already In ChatGPT
      </h2>
      <p class="mb-8 text-gray-500">Find out if your brand is being cited — or ignored — by AI search engines.</p>
      <a href="/lead-engine" class="inline-block rounded-lg bg-brand-600 px-8 py-4 font-semibold text-white hover:bg-brand-500">
        Run Your Free AI Visibility Audit →
      </a>
    </div>
  </section>

  <!-- Related Case Study -->
  <section class="border-t border-gray-200 bg-gray-50 py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h3 class="mb-6 text-center text-sm font-semibold uppercase tracking-wider text-gray-500">Related Case Study</h3>
      <a href="/portfolio/ecommerce-ai-visibility" class="group block rounded-xl border border-gray-200 bg-white p-8 transition-all hover:shadow-md hover:border-gray-300">
        <div class="text-xs font-semibold text-purple-400">AI SEARCH OPTIMIZATION</div>
        <h4 class="mt-2 text-xl font-bold text-gray-900 group-hover:text-brand-600">E-Commerce AI Visibility: From Invisible to Cited</h4>
        <p class="mt-2 text-sm text-gray-500">GEO optimization strategy that got a home goods brand cited in ChatGPT, Perplexity, and Gemini responses.</p>
        <div class="mt-4 flex gap-4 text-sm">
          <span class="text-gray-900 font-semibold">Lighthouse: 97</span>
          <span class="text-green-400 font-semibold">Traffic: +89%</span>
          <span class="text-purple-400 font-semibold">23 AI citations/mo</span>
        </div>
      </a>
    </div>
  </section>

  <!-- Related Reading -->
  <section class="border-t border-gray-200 py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h3 class="mb-6 text-center text-sm font-semibold uppercase tracking-wider text-gray-500">Related Reading</h3>
      <div class="grid gap-4 sm:grid-cols-3">
        <a href="/blog/how-to-get-cited-in-chatgpt" class="group rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-md hover:border-gray-300">
          <div class="text-xs font-semibold text-purple-500">GUIDE</div>
          <h4 class="mt-1 text-sm font-bold text-gray-900 group-hover:text-brand-600">Get Cited in ChatGPT</h4>
          <p class="mt-1 text-xs text-gray-500">Step-by-step citation engineering guide</p>
        </a>
        <a href="/blog/llms-txt-setup-guide" class="group rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-md hover:border-gray-300">
          <div class="text-xs font-semibold text-blue-500">GUIDE</div>
          <h4 class="mt-1 text-sm font-bold text-gray-900 group-hover:text-brand-600">llms.txt Setup Guide</h4>
          <p class="mt-1 text-xs text-gray-500">Make your website AI-friendly</p>
        </a>
        <a href="/blog/perplexity-seo-strategy" class="group rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-md hover:border-gray-300">
          <div class="text-xs font-semibold text-green-500">GUIDE</div>
          <h4 class="mt-1 text-sm font-bold text-gray-900 group-hover:text-brand-600">Perplexity SEO Strategy</h4>
          <p class="mt-1 text-xs text-gray-500">Get cited in Perplexity answers</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
