---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CalEmbed from "../../components/CalEmbed.tsx";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Web Development — Built for Search Performance",
  description: "High-performance websites engineered for Lighthouse 95+, sub-second load times, and LLM-optimized HTML. Built with Astro, edge-deployed.",
  provider: {
    "@type": "Organization",
    name: "RexBunny Services",
    url: "https://rexbunnyservices.online"
  },
  serviceType: "Web Development",
  areaServed: { "@type": "Country", name: "Canada" },
  url: "https://rexbunnyservices.online/services/web-development"
};

const benefits = [
  { metric: "0.4s", label: "Average LCP", desc: "Largest Contentful Paint" },
  { metric: "98", label: "Lighthouse Score", desc: "Performance + Best Practices" },
  { metric: "0.02", label: "Average CLS", desc: "Cumulative Layout Shift" },
  { metric: "45ms", label: "Average TBT", desc: "Total Blocking Time" },
];

const stackItems = [
  { name: "Astro", desc: "Zero-JS static output — LLM crawlers parse pure semantic HTML" },
  { name: "Edge CDN", desc: "Cloudflare Pages / Vercel Edge — sub-50ms TTFW globally" },
  { name: "Preact Islands", desc: "Interactive components without framework bloat" },
  { name: "Tailwind CSS", desc: "Utility-first, purged unused styles, < 10KB CSS" },
  { name: "PocketBase", desc: "Single-binary, SQLite-backed, self-hosted CMS" },
  { name: "Docker Stack", desc: "n8n + Listmonk + Cal.com — full automation suite" },
];
---

<BaseLayout
  title="Web Development | Built for Search Performance"
  description="High-performance websites from a marketing agency that engineers for search. Lighthouse 95+, sub-second load times, LLM-ready HTML. Built with Astro, edge-deployed."
  breadcrumbs={[
    { name: "Services", url: "/services" },
    { name: "Web Development", url: "/services/web-development" }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <!-- Hero -->
  <section class="pt-24">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="mb-6 text-4xl font-extrabold text-gray-900 sm:text-5xl">
          Websites Built by a <span class="text-brand-600">Marketing Agency</span> That Understands Search
        </h1>
        <p class="mb-8 text-lg text-gray-600">
          High-performance websites engineered for Lighthouse 95+, sub-second load times, and LLM-optimized HTML. Built with Astro, edge-deployed, AI-ready — because every technical decision impacts your search visibility.
        </p>
        <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a href="/lead-engine" class="rounded-lg bg-brand-600 px-8 py-4 font-semibold text-white hover:bg-brand-500">
            Run Your Free Performance Audit →
          </a>
          <CalEmbed buttonText="Book a Strategy Call" />
        </div>
      </div>
    </div>
  </section>

  <!-- Performance Metrics -->
  <section class="border-y border-gray-200 bg-gray-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
        {benefits.map((b) => (
          <div class="rounded-xl border border-gray-200 bg-white p-6 text-center">
            <div class="text-3xl font-bold text-brand-600">{b.metric}</div>
            <div class="mt-2 text-sm font-medium text-gray-900">{b.label}</div>
            <div class="mt-1 text-xs text-gray-500">{b.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The Stack -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-2 text-center text-3xl font-bold text-gray-900">The RexBunny Stack</h2>
      <p class="mb-12 text-center text-gray-500">Every technology chosen for speed, SEO, and AI crawl efficiency.</p>
      <div class="grid gap-4 md:grid-cols-3">
        {stackItems.map((item) => (
          <div class="rounded-xl border border-gray-200 bg-white p-6">
            <h3 class="mb-2 text-lg font-bold text-gray-900">{item.name}</h3>
            <p class="text-sm text-gray-500">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-gray-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-12 text-center text-3xl font-bold text-gray-900">Our Engineering Process</h2>
      <div class="grid gap-4 md:grid-cols-4">
        {[
          { step: "1", title: "Audit", desc: "Full Lighthouse audit, Core Web Vitals analysis, bundle inspection, crawlability check." },
          { step: "2", title: "Architect", desc: "Design the optimal stack. Static vs SSR. Edge strategy. CDN configuration." },
          { step: "3", title: "Build", desc: "Implement with Astro islands, auto-image optimization, code-splitting, critical CSS." },
          { step: "4", title: "Optimize", desc: "Sub-50ms server responses, preload critical assets, HTTP/3, Brotli compression." },
        ].map((item) => (
          <div class="rounded-xl border border-gray-200 bg-white p-6">
            <div class="mb-3 text-sm font-bold text-brand-500">Step {item.step}</div>
            <h3 class="mb-2 text-lg font-bold text-gray-900">{item.title}</h3>
            <p class="text-sm text-gray-500">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="mb-4 text-3xl font-bold text-gray-900">Ready for a Website That Actually Performs?</h2>
      <p class="mb-8 text-gray-500">Get your free Lighthouse audit and see exactly where your current site stands.</p>
      <a href="/lead-engine" class="inline-block rounded-lg bg-brand-600 px-8 py-4 font-semibold text-white hover:bg-brand-500">
        Run Your Free Audit →
      </a>
    </div>
  </section>

  <!-- Related Case Study -->
  <section class="border-t border-gray-200 bg-gray-50 py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h3 class="mb-6 text-center text-sm font-semibold uppercase tracking-wider text-gray-500">Related Case Study</h3>
      <a href="/portfolio/saas-platform-rebuild" class="group block rounded-xl border border-gray-200 bg-white p-8 transition-all hover:shadow-md hover:border-gray-300">
        <div class="text-xs font-semibold text-blue-400">WEB DEVELOPMENT</div>
        <h4 class="mt-2 text-xl font-bold text-gray-900 group-hover:text-brand-600">SaaS Platform Rebuild: From 6s to 0.4s LCP</h4>
        <p class="mt-2 text-sm text-gray-500">Complete platform rebuild using Astro + Preact Islands, cutting load times by 87% and doubling conversion rates.</p>
        <div class="mt-4 flex gap-4 text-sm">
          <span class="text-gray-900 font-semibold">Lighthouse: 98</span>
          <span class="text-green-400 font-semibold">Traffic: +142%</span>
          <span class="text-blue-400 font-semibold">LCP: 0.4s</span>
        </div>
      </a>
    </div>
  </section>

  <!-- Related Reading -->
  <section class="border-t border-gray-200 py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h3 class="mb-6 text-center text-sm font-semibold uppercase tracking-wider text-gray-500">Related Reading</h3>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/blog/lighthouse-100-blueprint" class="group rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-md hover:border-gray-300">
          <div class="text-xs font-semibold text-blue-500">GUIDE</div>
          <h4 class="mt-1 text-sm font-bold text-gray-900 group-hover:text-brand-600">Lighthouse 100 Blueprint</h4>
          <p class="mt-1 text-xs text-gray-500">Step-by-step to a perfect performance score</p>
        </a>
        <a href="/blog/llms-txt-setup-guide" class="group rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-md hover:border-gray-300">
          <div class="text-xs font-semibold text-purple-500">GUIDE</div>
          <h4 class="mt-1 text-sm font-bold text-gray-900 group-hover:text-brand-600">llms.txt Setup Guide</h4>
          <p class="mt-1 text-xs text-gray-500">Make your website AI-crawler friendly</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
