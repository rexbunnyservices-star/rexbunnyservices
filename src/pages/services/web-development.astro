---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CalEmbed from "../../components/CalEmbed.tsx";

const benefits = [
  { metric: "0.4s", label: "Average LCP", desc: "Largest Contentful Paint" },
  { metric: "98", label: "Lighthouse Score", desc: "Performance + Best Practices" },
  { metric: "0.02", label: "Average CLS", desc: "Cumulative Layout Shift" },
  { metric: "45ms", label: "Average TBT", desc: "Total Blocking Time" },
];

const stackItems = [
  { name: "Astro", desc: "Zero-JS static output — LLM crawlers parse pure semantic HTML" },
  { name: "Edge CDN", desc: "Cloudflare Pages / Vercel Edge — sub-50ms TTFW globally" },
  { name: "Preact Islands", desc: "Interactive components without framework bloat" },
  { name: "Tailwind CSS", desc: "Utility-first, purged unused styles, < 10KB CSS" },
  { name: "PocketBase", desc: "Single-binary, SQLite-backed, self-hosted CMS" },
  { name: "Docker Stack", desc: "n8n + Listmonk + Cal.com — full automation suite" },
];
---

<BaseLayout
  title="Next-Gen Web Development"
  description="High-performance websites engineered for Lighthouse 95+, sub-second load times, and LLM-optimized HTML. Built with Astro, edged-deployed, AI-ready."
>
  <!-- Hero -->
  <section class="pt-24">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="mb-6 text-4xl font-extrabold text-white sm:text-5xl">
          Sites That Ship in Under <span class="text-brand-400">0.5s</span>
        </h1>
        <p class="mb-8 text-lg text-dark-300">
          Built on Astro. Edge-deployed. LLM-optimized. Every millisecond engineered for conversion and crawlability.
        </p>
        <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a href="/lead-engine" class="rounded-lg bg-brand-600 px-8 py-4 font-semibold text-white hover:bg-brand-500">
            Run Your Free Performance Audit →
          </a>
          <CalEmbed buttonText="Book a Strategy Call" />
        </div>
      </div>
    </div>
  </section>

  <!-- Performance Metrics -->
  <section class="border-y border-dark-800 bg-dark-900/50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
        {benefits.map((b) => (
          <div class="rounded-xl border border-dark-800 bg-dark-900 p-6 text-center">
            <div class="text-3xl font-bold text-brand-400">{b.metric}</div>
            <div class="mt-2 text-sm font-medium text-white">{b.label}</div>
            <div class="mt-1 text-xs text-dark-400">{b.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The Stack -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-2 text-center text-3xl font-bold text-white">The REX Bunny Stack</h2>
      <p class="mb-12 text-center text-dark-400">Every technology chosen for speed, SEO, and AI crawl efficiency.</p>
      <div class="grid gap-4 md:grid-cols-3">
        {stackItems.map((item) => (
          <div class="rounded-xl border border-dark-800 bg-dark-900 p-6">
            <h3 class="mb-2 text-lg font-bold text-white">{item.name}</h3>
            <p class="text-sm text-dark-400">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-dark-900/50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-12 text-center text-3xl font-bold text-white">Our Engineering Process</h2>
      <div class="grid gap-4 md:grid-cols-4">
        {[
          { step: "1", title: "Audit", desc: "Full Lighthouse audit, Core Web Vitals analysis, bundle inspection, crawlability check." },
          { step: "2", title: "Architect", desc: "Design the optimal stack. Static vs SSR. Edge strategy. CDN configuration." },
          { step: "3", title: "Build", desc: "Implement with Astro islands, auto-image optimization, code-splitting, critical CSS." },
          { step: "4", title: "Optimize", desc: "Sub-50ms server responses, preload critical assets, HTTP/3, Brotli compression." },
        ].map((item) => (
          <div class="rounded-xl border border-dark-800 bg-dark-900 p-6">
            <div class="mb-3 text-sm font-bold text-brand-500">Step {item.step}</div>
            <h3 class="mb-2 text-lg font-bold text-white">{item.title}</h3>
            <p class="text-sm text-dark-400">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="mb-4 text-3xl font-bold text-white">Ready for a Website That Actually Performs?</h2>
      <p class="mb-8 text-dark-400">Get your free Lighthouse audit and see exactly where your current site stands.</p>
      <a href="/lead-engine" class="inline-block rounded-lg bg-brand-600 px-8 py-4 font-semibold text-white hover:bg-brand-500">
        Run Your Free Audit →
      </a>
    </div>
  </section>
</BaseLayout>
