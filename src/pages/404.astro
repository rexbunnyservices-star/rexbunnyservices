---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="That page doesn't exist. Try the free audit, our services, or case studies."
>
  <section class="pt-24">
    <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:px-8">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[2px] text-brand-600">404</p>
      <h1 class="mb-6 text-4xl font-extrabold text-gray-900">This page doesn't exist</h1>
      <p class="mb-10 text-lg text-gray-600">
        The link may be out of date. Nothing here — but these might help.
      </p>
      <div class="mx-auto grid max-w-xl gap-3 sm:grid-cols-2">
        <a
          href="/lead-engine"
          class="rounded-lg bg-gradient-to-r from-brand-500 to-rex-orange px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/20 transition-all hover:shadow-xl hover:-translate-y-0.5"
        >
          Get My Free Audit
        </a>
        <a
          href="/services/seo"
          class="rounded-lg border border-gray-300 px-5 py-3 text-sm font-semibold text-gray-700 transition-colors hover:border-brand-500 hover:text-brand-600"
        >
          SEO Services
        </a>
        <a
          href="/portfolio"
          class="rounded-lg border border-gray-300 px-5 py-3 text-sm font-semibold text-gray-700 transition-colors hover:border-brand-500 hover:text-brand-600"
        >
          Case Studies
        </a>
        <a
          href="/contact"
          class="rounded-lg border border-gray-300 px-5 py-3 text-sm font-semibold text-gray-700 transition-colors hover:border-brand-500 hover:text-brand-600"
        >
          Contact
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
