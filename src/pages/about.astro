---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalEmbed from '../components/CalEmbed.tsx';

const siteUrl = 'https://rexbunnyservices.online';
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About RexBunny Services',
  description:
    'A growth engineering practice covering AI search optimization (SEO, GEO, AEO), website generation, lead generation, ad campaigns, ecommerce dashboards, and AI visual production.',
  mainEntity: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'RexBunny Services',
    url: siteUrl,
  },
};
---

<BaseLayout
  title="About Us | Growth Engineering for AI Search"
  description="RexBunny Services is a founder-led growth engineering practice covering AI search optimization, website generation, lead generation, ad campaigns, ecommerce dashboards, and AI visual production."
  breadcrumbs={[{ name: 'About', url: '/about' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
  <section class="pt-24">
    <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
      <h1 class="mb-6 text-4xl font-extrabold text-gray-900 sm:text-5xl">
        Growth Engineering for <span class="text-brand-400">Every Way People Search</span>
      </h1>
      <div class="prose max-w-none text-gray-600">
        <p class="text-lg leading-relaxed">
          Search has fractured. Customers now find businesses through Google, ChatGPT, Siri, Alexa,
          Gemini, Perplexity, AI Overviews, and voice assistants — each with different rules for who
          gets featured. Most marketing agencies only optimize for one channel.
        </p>
        <p class="mt-4 text-lg leading-relaxed">
          RexBunny Services is a growth engineering practice built for this reality. We cover every
          search surface — traditional (SEO), AI-generated (GEO), and direct answers (AEO) — then
          connect them to the systems that turn visibility into pipeline: the site, the lead engine,
          the campaigns, and the dashboard that proves it. We don't just help you rank; we build the
          whole path from search to signed customer.
        </p>

        <h2 class="mt-12 mb-4 text-2xl font-bold text-gray-900">Who We Are</h2>
        <p>
          Practising since 2023. Agency since 2026. Anass has been doing this work long before it
          had a name on a business card — first as a freelancer for other people&rsquo;s clients,
          then independently, and since 2026 as RexBunny Services.
        </p>
        <p class="mt-4">
          The practice is deliberately small. Anass builds and runs every engagement directly — no
          account-manager layer, no work handed to a junior team you never meet. That means the
          person scoping your system is the person shipping it, across search engineering,
          structured data, web performance, automation, and reporting.
        </p>
        <div
          class="mt-6 flex items-start gap-4 rounded-2xl border border-brand-200 bg-brand-50 p-5"
        >
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-600 font-display text-lg font-bold text-white"
          >
            A
          </div>
          <div>
            <div class="font-bold text-gray-900">Anass</div>
            <div class="text-sm text-gray-500">Remote Freelancer &amp; Founder</div>
            <p class="mt-2 text-sm text-gray-600">
              A remote freelancer working worldwide. Runs strategy, implementation, and reporting
              directly — no handoffs, no account-manager layer.
            </p>
          </div>
        </div>

        <h2 class="mt-12 mb-4 text-2xl font-bold text-gray-900">Why Three Search Channels?</h2>
        <p>
          <strong>SEO (Search Engine Optimization)</strong> — The foundation. Ranking on Google, Bing,
          and other traditional search engines through technical health, backlinks, and content authority.
          Still drives the majority of web traffic.
        </p>
        <p>
          <strong>GEO (Generative Engine Optimization)</strong> — Getting your brand cited as a source
          inside AI responses from ChatGPT, Gemini, Perplexity, and Copilot. Entity clarity, structured
          data depth, and citation-worthiness are the new ranking factors.
        </p>
        <p>
          <strong>AEO (Answer Engine Optimization)</strong> — Making your content the direct answer that
          AI Overviews, featured snippets, Siri, and Alexa read aloud. AEO puts you in the response.
        </p>
        <p>
          Most businesses invest in one or two of these channels. We ensure you're visible across
          all three — because your customers use all of them.
        </p>

        <h2 class="mt-12 mb-4 text-2xl font-bold text-gray-900">Our Approach</h2>
        <p>
          Every engagement starts with a thorough audit of your current search visibility — across
          Google, AI citations, and direct answers. From there, we build a tailored strategy that
          addresses your specific gaps, whether that's fixing Core Web Vitals, restructuring content
          for LLM consumption, or engineering direct answers for voice search.
        </p>
        <p>
          Every recommendation is backed by data. We track rankings, AI citation frequency, featured
          snippet presence, Lighthouse scores, and conversion metrics to prove ROI — not just
          activity.
        </p>

        <div class="mt-10 grid gap-4 md:grid-cols-4">
          <div class="rounded-xl border border-gray-200 bg-white p-6 text-center">
            <div class="text-3xl font-bold text-blue-400">SEO</div>
            <div class="mt-1 text-sm text-gray-500">Traditional search</div>
          </div>
          <div class="rounded-xl border border-gray-200 bg-white p-6 text-center">
            <div class="text-3xl font-bold text-purple-400">GEO</div>
            <div class="mt-1 text-sm text-gray-500">AI citations</div>
          </div>
          <div class="rounded-xl border border-gray-200 bg-white p-6 text-center">
            <div class="text-3xl font-bold text-brand-400">AEO</div>
            <div class="mt-1 text-sm text-gray-500">Direct answers</div>
          </div>
          <div class="rounded-xl border border-gray-200 bg-white p-6 text-center">
            <div class="text-3xl font-bold text-gray-900">Web Dev</div>
            <div class="mt-1 text-sm text-gray-500">Performance option</div>
          </div>
        </div>
      </div>
      <div class="mt-10 text-center">
        <CalEmbed buttonText="Book a Strategy Call →" />
      </div>
    </div>
  </section>
</BaseLayout>
