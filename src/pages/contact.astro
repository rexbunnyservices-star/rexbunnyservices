---
import BaseLayout from "../layouts/BaseLayout.astro";
import CalEmbed from "../components/CalEmbed.tsx";
import ContactForm from "../components/ContactForm.tsx";
---

<BaseLayout
  title="Contact RexBunny Services | Get Your Free AI Visibility Audit"
  description="Get in touch with RexBunny Services. Book a strategy call, send us a message, or email us to discuss your web development, SEO, or AI search optimization needs."
  breadcrumbs={[
    { name: "Contact", url: "/contact" }
  ]}
>
  <section class="pt-24">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="mb-4 text-4xl font-extrabold text-gray-900">Let's Talk</h1>
        <p class="mb-8 text-lg text-gray-600">
          Ready to make your brand visible in AI search? Book a call, send a message, or email us directly.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-2">
        <!-- Contact Form -->
        <div class="rounded-xl border border-gray-200 bg-white p-8">
          <h2 class="mb-6 text-xl font-bold text-gray-900">Send Us a Message</h2>
          <ContactForm client:load />
        </div>

        <!-- Book a Call -->
        <div class="space-y-6">
          <div class="rounded-xl border border-gray-200 bg-white p-8">
            <div class="mb-6">
              <h2 class="text-xl font-bold text-gray-900">Book a Strategy Call</h2>
              <p class="mt-2 text-sm text-gray-500">
                Free 30-minute call. We'll review your goals and build a custom roadmap.
              </p>
            </div>
            <div class="text-center">
              <CalEmbed buttonText="Schedule Your Call →" className="w-full" />
            </div>
          </div>

          <div class="rounded-xl border border-gray-200 bg-white p-8">
            <h3 class="mb-4 text-lg font-bold text-gray-900">Or Reach Us Directly</h3>
            <div class="space-y-3">
              <a href="mailto:help@rexbunnyservices.com" class="flex items-center gap-3 text-gray-600 hover:text-brand-600">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                help@rexbunnyservices.com
              </a>
              <p class="flex items-center gap-3 text-gray-600">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                Serving businesses across the US, Canada & UK
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="mx-auto mt-8 max-w-2xl text-center">
        <p class="text-sm text-gray-400">
          Prefer to start with a free audit? <a href="/lead-engine" class="text-brand-600 hover:text-brand-500">Run your AI Visibility Audit →</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
