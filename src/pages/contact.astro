---
import BaseLayout from "../layouts/BaseLayout.astro";
import CalEmbed from "../components/CalEmbed.tsx";
---

<BaseLayout
  title="Contact REX Bunny Services | Get Your Free AI Visibility Audit"
  description="Get in touch with REX Bunny Services. Book a strategy call, or email us to discuss your web development, SEO, or AI search optimization needs."
  breadcrumbs={[
    { name: "Contact", url: "/contact" }
  ]}
>
  <section class="pt-24">
    <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="mb-4 text-4xl font-extrabold text-white">Let's Talk</h1>
        <p class="mb-8 text-lg text-dark-300">
          Ready to make your brand visible in AI search? Book a call or email us directly.
        </p>
      </div>

      <div class="mx-auto max-w-lg">
        <div class="rounded-xl border border-dark-800 bg-dark-900 p-8">
          <div class="mb-6 text-center">
            <h2 class="text-xl font-bold text-white">Book a Strategy Call</h2>
            <p class="mt-2 text-sm text-dark-400">
              Free 30-minute call. We'll review your audit results and build a custom roadmap.
            </p>
          </div>
          <div class="text-center">
            <CalEmbed buttonText="Schedule Your Call →" className="w-full" />
          </div>
          <div class="mt-8 border-t border-dark-800 pt-6 text-center">
            <p class="mb-2 text-sm text-dark-400">Or email us directly</p>
            <a href="mailto:help@rexbunnyservices.com" class="text-brand-400 hover:text-brand-300">
              help@rexbunnyservices.com
            </a>
          </div>
        </div>
      </div>

      <div class="mx-auto mt-8 max-w-2xl text-center">
        <p class="text-sm text-dark-500">
          Prefer to start with a free audit? <a href="/lead-engine" class="text-brand-400 hover:text-brand-300">Run your AI Visibility Audit →</a>
        </p>
      </div>

      <div class="mx-auto mt-4 max-w-2xl text-center">
        <p class="text-sm text-dark-500">
          Looking for a home instead? <a href="/tower7" class="text-brand-400 hover:text-brand-300">Explore Tower 7, Aspire Silicon City →</a>
        </p>
      </div>

      <div class="mx-auto mt-16 max-w-2xl text-center">
        <h2 class="mb-4 text-xl font-bold text-white">REX Bunny Services</h2>
        <div class="space-y-1 text-dark-400">
          <p>AI Search Optimization & Web Development Agency</p>
          <p>help@rexbunnyservices.com</p>
          <p class="text-sm text-dark-500">Serving businesses across the United States, Canada, and the United Kingdom</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
