---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Blog"
  description="The REX Bunny Services blog — GEO strategies, SEO tactics, web performance guides, and AI search insights."
>
  <section class="pt-24">
    <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
      <h1 class="mb-4 text-4xl font-extrabold text-white sm:text-5xl">Blog</h1>
      <p class="mb-12 text-lg text-dark-400">
        GEO strategies, SEO tactics, and web performance guides.
      </p>
      <div class="space-y-6">
        {[
          { title: "What is Generative Engine Optimization (GEO)?", date: "2026-06-15", desc: "A complete guide to optimizing your website for AI search engines like ChatGPT, Gemini, and Perplexity." },
          { title: "Lighthouse 100: How We Engineer Sub-Second Sites", date: "2026-06-01", desc: "Our technical blueprint for achieving perfect Lighthouse scores with Astro and edge deployment." },
          { title: "Programmatic Local SEO at Scale", date: "2026-05-20", desc: "How to generate 500+ city-specific landing pages with automated schema, content, and monitoring." },
        ].map((post) => (
          <article class="group rounded-xl border border-dark-800 bg-dark-900 p-6 transition-all hover:border-brand-500/30">
            <div class="mb-2 text-xs text-dark-500">{post.date}</div>
            <h2 class="mb-2 text-xl font-bold text-white group-hover:text-brand-400">
              <a href="#">{post.title}</a>
            </h2>
            <p class="text-sm text-dark-400">{post.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
