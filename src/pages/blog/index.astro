---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog"
  description="The REX Bunny Services blog — SEO strategies, GEO tactics, AEO guides, web performance tips, and AI search insights from a marketing agency built for 2026."
>
  <section class="pt-24">
    <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
      <h1 class="mb-4 text-4xl font-extrabold text-white sm:text-5xl">Blog</h1>
      <p class="mb-12 text-lg text-dark-400">
        GEO strategies, SEO tactics, and web performance guides.
      </p>
      <div class="space-y-6">
        {
          posts.map((post) => (
            <article class="group rounded-xl border border-dark-800 bg-dark-900 p-6 transition-all hover:border-brand-500/30">
              <div class="mb-2 flex items-center gap-2 text-xs text-dark-500">
                <time>{post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
                <span>·</span>
                <span>{post.data.author}</span>
              </div>
              <h2 class="mb-2 text-xl font-bold text-white group-hover:text-brand-400">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h2>
              <p class="mb-3 text-sm text-dark-400">{post.data.description}</p>
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="rounded bg-dark-800 px-2 py-1 text-xs text-dark-400">{tag}</span>
                ))}
              </div>
            </article>
          ))
        }
        {
          posts.length === 0 && (
            <p class="text-dark-500">No blog posts yet. Check back soon!</p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
