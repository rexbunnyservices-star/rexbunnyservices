---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { GetStaticPathsResult } from "astro";

export async function getStaticPaths(): Promise<GetStaticPathsResult> {
  return [{ params: { slug: "hello-world" } }];
}

const { slug } = Astro.params;
---

<BaseLayout
  title="Blog Post"
  description="Blog post from REX Bunny Services."
>
  <section class="pt-24">
    <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mb-8">
        <a href="/blog" class="text-sm text-brand-400 hover:text-brand-300">← Back to Blog</a>
      </div>
      <h1 class="mb-4 text-3xl font-extrabold text-white">Blog Post: {slug}</h1>
      <div class="prose prose-invert text-dark-300">
        <p>This blog post will be populated from MDX content in <code class="text-brand-400">src/content/blog/</code>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
