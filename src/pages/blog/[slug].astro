---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CalEmbed from "../../components/CalEmbed.tsx";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const siteUrl = "https://rexbunnyservices.online";
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  breadcrumbs={[
    { name: "Blog", url: "/blog" },
    { name: post.data.title, url: `/blog/${post.id}` }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.pubDate.toISOString(),
    "author": {
      "@type": "Organization",
      "name": "RexBunny Services",
      "url": siteUrl
    },
    "publisher": {
      "@type": "Organization",
      "name": "RexBunny Services",
      "url": siteUrl,
      "logo": `${siteUrl}/images/logo.png`
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `${siteUrl}/blog/${post.id}`
    },
    "keywords": post.data.tags.join(", ")
  })} />
  <section class="pt-24">
    <article class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mb-8">
        <a href="/blog" class="text-sm text-brand-600 hover:text-brand-700">← Back to Blog</a>
      </div>
      <header class="mb-8">
        <h1 class="mb-4 text-3xl font-extrabold text-gray-900 sm:text-4xl">{post.data.title}</h1>
        <div class="flex items-center gap-2 text-sm text-gray-400">
          <time>{post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
          <span>·</span>
          <span>{post.data.author}</span>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="rounded bg-gray-100 px-2 py-1 text-xs text-gray-500">{tag}</span>
          ))}
        </div>
      </header>
      <div class="prose prose-brand max-w-none text-gray-600">
        <Content />
      </div>

      <!-- Related Services -->
      <div class="mt-16 border-t border-gray-200 pt-12">
        <h3 class="mb-6 text-sm font-semibold uppercase tracking-wider text-gray-500">Related Services</h3>
        <div class="grid gap-4 sm:grid-cols-2">
          {post.data.tags.some(t => ["GEO", "AI Search", "ChatGPT", "Perplexity", "llms.txt", "Citation Engineering"].includes(t)) && (
            <a href="/services/ai-search-optimization" class="group rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-md hover:border-gray-300">
              <div class="text-xs font-semibold text-purple-500">GEO</div>
              <h4 class="mt-1 text-base font-bold text-gray-900 group-hover:text-brand-600">AI Search Optimization</h4>
              <p class="mt-1 text-xs text-gray-500">Get cited in ChatGPT, Gemini, Perplexity & Copilot</p>
            </a>
          )}
          {post.data.tags.some(t => ["AEO", "Voice Search", "Featured Snippets", "Google AI Overviews"].includes(t)) && (
            <a href="/services/aeo" class="group rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-md hover:border-gray-300">
              <div class="text-xs font-semibold text-brand-500">AEO</div>
              <h4 class="mt-1 text-base font-bold text-gray-900 group-hover:text-brand-600">Answer Engine Optimization</h4>
              <p class="mt-1 text-xs text-gray-500">Be the answer in voice search & AI Overviews</p>
            </a>
          )}
          {post.data.tags.some(t => ["SEO", "Local SEO", "Technical SEO"].includes(t)) && (
            <a href="/services/seo" class="group rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-md hover:border-gray-300">
              <div class="text-xs font-semibold text-green-500">SEO</div>
              <h4 class="mt-1 text-base font-bold text-gray-900 group-hover:text-brand-600">SEO Services</h4>
              <p class="mt-1 text-xs text-gray-500">Technical SEO, local SEO & programmatic optimization</p>
            </a>
          )}
          {post.data.tags.some(t => ["Web Development", "Performance", "Lighthouse"].includes(t)) && (
            <a href="/services/web-development" class="group rounded-xl border border-gray-200 bg-white p-5 transition-all hover:shadow-md hover:border-gray-300">
              <div class="text-xs font-semibold text-blue-500">WEB DEV</div>
              <h4 class="mt-1 text-base font-bold text-gray-900 group-hover:text-brand-600">Web Development</h4>
              <p class="mt-1 text-xs text-gray-500">Lighthouse 95+ websites built for search</p>
            </a>
          )}
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 rounded-xl bg-gray-50 p-8 text-center">
        <h3 class="mb-2 text-lg font-bold text-gray-900">Want results like these?</h3>
        <p class="mb-4 text-sm text-gray-500">Run a free audit or book a strategy call to see what's possible.</p>
        <div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <a href="/lead-engine" class="rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-500">Free Audit →</a>
          <CalEmbed buttonText="Book a Call" />
        </div>
      </div>
    </article>
  </section>
</BaseLayout>
