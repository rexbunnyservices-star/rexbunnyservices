---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import ExitPopup from "../components/ExitPopup.astro";
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "@fontsource/inter/900.css";
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/700.css";
import "@fontsource/plus-jakarta-sans/800.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/700.css";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const { title, description, canonical, ogImage, ogType = "website", breadcrumbs, noindex = false } = Astro.props;
const siteUrl = "https://rexbunnyservices.online";
const pageUrl = canonical || Astro.url.pathname;
const fullUrl = `${siteUrl}${pageUrl}`;
const ogImageUrl = ogImage || `${siteUrl}/images/og-image.svg`;

const breadcrumbItems = breadcrumbs
  ? [{ name: "Home", url: siteUrl }, ...breadcrumbs.map(b => ({ name: b.name, url: b.url.startsWith("http") ? b.url : `${siteUrl}${b.url}` }))]
  : [{ name: "Home", url: siteUrl }];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | RexBunny Services</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${siteUrl}${pageUrl}`} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <meta name="theme-color" content="#f97316" />
    <meta name="author" content="RexBunny Services" />

    <!-- Umami Analytics -->
    <script async defer src="https://analytics.rexbunnyservices.online/script.js" data-website-id="89882bfd-5853-4835-8ee8-a54cc9b8f4a6"></script>

    <!-- Hreflang for international audience -->
    <link rel="alternate" hreflang="en" href={fullUrl} />
    <link rel="alternate" hreflang="en-us" href={fullUrl} />
    <link rel="alternate" hreflang="en-ca" href={fullUrl} />
    <link rel="alternate" hreflang="en-gb" href={fullUrl} />
    <link rel="alternate" hreflang="x-default" href={fullUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={`${title} | RexBunny Services`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:site_name" content="RexBunny Services" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} - RexBunny Services`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | RexBunny Services`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content="@rexbunnyservices" />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" data-schema="organization" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": `${siteUrl}/#organization`,
          "name": "RexBunny Services",
          "url": siteUrl,
          "logo": `${siteUrl}/images/logo.png`,
          "foundingDate": "2024-01-01",
          "founders": [
            {
              "@type": "Person",
              "@id": `${siteUrl}/#founder`,
              "name": "Anass",
              "jobTitle": "CEO & Lead Architect"
            }
          ],
          "sameAs": [
            "https://linkedin.com/company/rexbunnyservices"
          ],
          "address": {
            "@type": "PostalAddress",
            "addressCountry": "US"
          },
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "sales",
            "email": "help@rexbunnyservices.com",
            "availableLanguage": ["English"]
          },
          "description": "A marketing agency specializing in SEO, Generative Engine Optimization (GEO), and Answer Engine Optimization (AEO). We make brands visible in Google, ChatGPT, Gemini, Siri, Alexa, Perplexity, and Copilot."
        },
        {
          "@type": "ProfessionalService",
          "@id": `${siteUrl}/#service`,
          "name": "RexBunny Services — AI Search Optimization & Web Development",
          "provider": { "@id": `${siteUrl}/#organization` },
          "url": siteUrl,
          "areaServed": [
            { "@type": "Country", "name": "United States" },
            { "@type": "Country", "name": "Canada" },
            { "@type": "Country", "name": "United Kingdom" }
          ],
          "serviceType": [
            "Generative Engine Optimization",
            "AI Search Optimization",
            "Technical SEO",
            "Local SEO",
            "Web Development",
            "Performance Engineering",
            "Conversion Rate Optimization",
            "Structured Data Consulting"
          ],
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "RexBunny Service Packages",
            "itemListElement": [
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "GEO Growth Package",
                  "description": "Full entity optimization, LLM citation engineering, and AI search monitoring."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Web Performance Overhaul",
                  "description": "End-to-end rebuild or refactor to achieve Lighthouse 95+ and sub-second load times."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Programmatic Local SEO",
                  "description": "Scalable local SEO infrastructure for multi-location businesses."
                }
              }
            ]
          }
        },
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          "url": siteUrl,
          "name": "RexBunny Services",
          "publisher": { "@id": `${siteUrl}/#organization` },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": `${siteUrl}/search?q={search_term_string}`
            },
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "WebPage",
          "@id": `${siteUrl}/#webpage`,
          "url": siteUrl,
          "name": "RexBunny Services — AI Search Optimization & Web Development",
          "isPartOf": { "@id": `${siteUrl}/#website` },
          "about": { "@id": `${siteUrl}/#service` },
          "mainEntity": { "@id": `${siteUrl}/#service` },
          "specialty": [
            "Generative Engine Optimization",
            "AI Search Optimization",
            "LLM Citation Engineering",
            "Entity Optimization",
            "Technical SEO",
            "Web Performance Engineering"
          ],
          "significantLink": [
            `${siteUrl}/services/web-development`,
            `${siteUrl}/services/seo`,
            `${siteUrl}/services/ai-search-optimization`,
            `${siteUrl}/services/aeo`,
            `${siteUrl}/lead-engine`,
            `${siteUrl}/ai-search-statistics`
          ]
        },
        {
          "@type": "BreadcrumbList",
          "@id": `${siteUrl}/#breadcrumb`,
          "itemListElement": breadcrumbItems.map((item, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "name": item.name,
            "item": item.url
          }))
        }
      ]
    })} />
    <style>
      :root { scroll-behavior: smooth; }
      html.no-js [data-reveal] { opacity: 1 !important; }
      nav { transition: transform 0.4s cubic-bezier(0.22,1,0.36,1), background 0.3s ease, box-shadow 0.3s ease; }
      nav.nav-scrolled { background: rgba(255,255,255,0.95); box-shadow: 0 1px 12px rgba(0,0,0,0.06); }
      ::-moz-selection { background: rgba(249,115,22,0.2); }
      ::selection { background: rgba(249,115,22,0.2); }
      .skip-link { position: absolute; top: -100%; left: 1rem; z-index: 999; padding: 0.5rem 1rem; background: #f97316; color: #fff; border-radius: 0.5rem; font-weight: 600; font-size: 0.875rem; transition: top 0.2s; }
      .skip-link:focus { top: 0.75rem; }
      *:focus-visible { outline: 2px solid #f97316; outline-offset: 2px; border-radius: 4px; }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
        [data-reveal] { opacity: 1 !important; }
      }
    </style>
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div
      id="scroll-progress"
      class="fixed top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-brand-400 via-rex-orange to-rex-gold z-[200] origin-left scale-x-0"
    />
    <Navigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <ExitPopup />

    <script>
      import "../scripts/smoothScroll.ts";
    </script>
    <script>
      import "../scripts/scrollReveal.ts";
    </script>
    <script>
      import "../scripts/interactions.ts";
    </script>
  </body>
</html>
