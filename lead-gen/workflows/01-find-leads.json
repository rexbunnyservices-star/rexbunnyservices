{
  "name": "01 - Find Leads via Google Places",
  "id": "lf01findleads01",
  "versionId": "v1lf01findleads01",
  "nodes": [
    {
      "parameters": {
        "path": "find-leads",
        "responseMode": "lastNode",
        "webhookId": "wh_findleads_01a1b2c3d4e5"
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "url": "=https://maps.googleapis.com/maps/api/place/textsearch/json?query={{ encodeURIComponent($json.query) }}&key={{ $credentials.googlePlaces.apiKey }}",
        "method": "GET",
        "sendBody": false,
        "options": {}
      },
      "id": "google-places",
      "name": "Google Places API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "const leads = $json.results || [];\nconst query = $node[\"Webhook Trigger\"].json.query || \"dentist Chicago\";\n\nreturn leads.map(place => ({\n  name: place.name,\n  address: place.formatted_address,\n  placeId: place.place_id,\n  rating: place.rating || 0,\n  totalRatings: place.user_ratings_total || 0,\n  types: place.types?.join(', ') || '',\n  website: place.website || '',\n  phoneNumber: place.formatted_phone_number || '',\n  lat: place.geometry?.location?.lat,\n  lng: place.geometry?.location?.lng,\n  searchQuery: query,\n  niche: $json.activeNiche || 'local_business',\n  source: 'google_places',\n  status: 'discovered',\n  createdAt: new Date().toISOString()\n}));"
      },
      "id": "parse-results",
      "name": "Parse Places Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
 "url": "={{ $env.POCKETBASE_URL || 'http://pocketbase:8090' }}/api/collections/prospects/records",
 "method": "POST",
 "sendBody": true,
 "bodyParameters": {
   "parameters": [
     { "name": "name", "value": "={{ $json.name }}" },
     { "name": "address", "value": "={{ $json.address }}" },
     { "name": "placeId", "value": "={{ $json.placeId }}" },
     { "name": "rating", "value": "={{ $json.rating }}" },
     { "name": "totalRatings", "value": "={{ $json.totalRatings }}" },
     { "name": "businessType", "value": "={{ $json.types }}" },
     { "name": "website", "value": "={{ $json.website }}" },
     { "name": "phoneNumber", "value": "={{ $json.phoneNumber }}" },
     { "name": "lat", "value": "={{ $json.lat }}" },
     { "name": "lng", "value": "={{ $json.lng }}" },
     { "name": "searchQuery", "value": "={{ $json.searchQuery }}" },
     { "name": "niche", "value": "={{ $json.niche }}" },
     { "name": "source", "value": "={{ $json.source }}" },
     { "name": "status", "value": "={{ $json.status }}" }
   ]
 },
 "options": {}
      },
      "id": "save-to-pocketbase",
      "name": "Save to PocketBase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [750, 300]
    },
    {
      "parameters": {
 "url": "={{ $env.LISTMONK_URL }}/api/subscribers",
 "method": "POST",
 "sendBody": true,
 "bodyParameters": {
   "parameters": [
     { "name": "email", "value": "={{ $json.email || 'pending@placeholder.com' }}" },
     { "name": "name", "value": "={{ $json.name }}" },
     { "name": "status", "value": "enabled" },
     { "name": "lists", "value": "[1]" },
     { "name": "attribs", "value": "={{ { placeId: $json.placeId, niche: $json.niche, website: $json.website } }}" }
   ]
 },
 "options": {}
      },
      "id": "add-to-listmonk",
      "name": "Add to Listmonk",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1000, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Google Places API", "type": "main", "index": 0 }]]
    },
    "Google Places API": {
      "main": [[{ "node": "Parse Places Results", "type": "main", "index": 0 }]]
    },
    "Parse Places Results": {
      "main": [[{ "node": "Save to PocketBase", "type": "main", "index": 0 }]]
    },
    "Save to PocketBase": {
      "main": [[{ "node": "Add to Listmonk", "type": "main", "index": 0 }]]
    }
  }
}
