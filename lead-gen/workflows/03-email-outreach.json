{
  "name": "03 - Email Outreach & Follow-ups",
  "id": "lf03emailoutreach",
  "versionId": "v1lf03emailoutreach",
  "nodes": [
    {
      "parameters": {
        "path": "start-outreach",
        "responseMode": "lastNode"
      },
      "id": "outreach-webhook",
      "name": "Outreach Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.POCKETBASE_URL || 'http://pocketbase:8090' }}/api/collections/prospects/records/{{ $json.prospectId }}",
        "method": "GET",
        "sendBody": false,
        "options": {}
      },
      "id": "fetch-lead",
      "name": "Fetch Lead Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "const lead = $json;\nconst niche = lead.niche || 'local_business';\n\n// Outreach config by niche\nconst config = {\n  local_business: {\n    subjectPrefix: 'Quick observation about',\n    freeOffer: 'Free AI Visibility audit report',\n    followUpDays: [3, 7, 14],\n    maxFollowUps: 3\n  },\n  podcast_clipping: {\n    subjectPrefix: 'Your podcast is leaving money on the table',\n    freeOffer: '1 free clip from your latest episode',\n    followUpDays: [3, 6, 12],\n    maxFollowUps: 3\n  },\n  saas_founder: {\n    subjectPrefix: 'Your site is bleeding traffic',\n    freeOffer: 'Free Lighthouse + AI visibility score report',\n    followUpDays: [3, 7, 14],\n    maxFollowUps: 3\n  }\n};\n\nconst cfg = config[niche] || config.local_business;\n\nreturn [{\n  ...lead,\n  outreachConfig: cfg,\n  followUpCount: 0,\n  lastContactedAt: null,\n  campaignStatus: 'first_email_pending'\n}];"
      },
      "id": "prepare-outreach",
      "name": "Prepare Outreach Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "jsCode": "const lead = $json;\nconst emailTo = lead.email;\nconst emailBody = lead.personalizedEmail || '';\nconst subject = lead.emailSubject || '';\n\nif (!emailTo || emailTo === 'pending@placeholder.com' || !emailBody) {\n  return [{ ...lead, skipped: true, skipReason: 'No email or body' }];\n}\n\n// Build SMTP email payload\nreturn [{\n  ...lead,\n  mailPayload: {\n    from: lead.outreachConfig?.senderEmail || 'hi@rexbunnyservices.com',\n    to: emailTo,\n    subject: subject,\n    text: `${lead.outreachConfig?.freeOffer || ''}\\n\\n${emailBody}\\n\\n---\\n${lead.valueProposition || ''}\\n\\nBook a free call: {{ $credentials.calComUrl || 'https://cal.rexbunnyservices.online' }}`\n  }\n}];"
      },
      "id": "build-email-payload",
      "name": "Build Email Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "url": "smtp://email-smtp.us-east-1.amazonaws.com:587",
        "method": "POST",
        "sendBody": true,
        "authentication": "genericCredentialType",
        "nodeCredentialType": "smtp",
        "bodyParameters": {
          "parameters": [
            { "name": "from", "value": "={{ $json.mailPayload.from }}" },
            { "name": "to", "value": "={{ $json.mailPayload.to }}" },
            { "name": "subject", "value": "={{ $json.mailPayload.subject }}" },
            { "name": "text", "value": "={{ $json.mailPayload.text }}" }
          ]
        },
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email via SMTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  ...$json,\n  campaignStatus: 'email_sent',\n  lastContactedAt: new Date().toISOString(),\n  followUpCount: 0\n}];"
      },
      "id": "record-sent",
      "name": "Record Email Sent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.POCKETBASE_URL || 'http://pocketbase:8090' }}/api/collections/prospects/records/{{ $json.id }}",
        "method": "PATCH",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "campaignStatus", "value": "={{ $json.campaignStatus }}" },
            { "name": "lastContactedAt", "value": "={{ $json.lastContactedAt }}" },
            { "name": "followUpCount", "value": "={{ $json.followUpCount }}" }
          ]
        },
        "options": {}
      },
      "id": "update-pb-sent",
      "name": "Update PB (Email Sent)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1500, 300]
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "days"
      },
      "id": "wait-followup-1",
      "name": "Wait 3 Days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1750, 300]
    },
    {
      "parameters": {
        "jsCode": "// Simulated reply check. Replace with Gmail API or IMAP call.\n// For now, returns false to trigger follow-up.\nconst hasReplied = false;\n\nreturn [{\n  ...$json,\n  hasReplied,\n  shouldFollowUp: !hasReplied && ($json.followUpCount || 0) < ($json.outreachConfig?.maxFollowUps || 3)\n}];"
      },
      "id": "check-reply",
      "name": "Check for Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.shouldFollowUp }}", "operation": "equal", "value2": "true" }
          ]
        }
      },
      "id": "should-followup",
      "name": "Send Follow-up?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2250, 300]
    },
    {
      "parameters": {
        "jsCode": "const lead = $json;\nconst followUpNum = (lead.followUpCount || 0) + 1;\n\nreturn [{\n  ...lead,\n  emailSubject: `Re: ${lead.emailSubject || ''}`,\n  mailPayload: {\n    from: 'hi@rexbunnyservices.com',\n    to: lead.email,\n    subject: `Re: ${lead.emailSubject || ''}`,\n    text: `Hi ${lead.name || 'there'},\n\nJust following up on my previous email. I wanted to make sure you saw my offer for ${lead.outreachConfig?.freeOffer || 'a free audit'}.\n\nNo pressure at all - just wanted to check if you had any questions or if now might be a good time to chat.\n\n${lead.valueProposition || ''}\n\nBest,\nAnass\n---\nrexbunnyservices.com`\n  },\n  followUpCount: followUpNum\n}];"
      },
      "id": "build-followup",
      "name": "Build Follow-up Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2500, 200]
    },
    {
      "parameters": {
        "url": "smtp://email-smtp.us-east-1.amazonaws.com:587",
        "method": "POST",
        "sendBody": true,
        "authentication": "genericCredentialType",
        "nodeCredentialType": "smtp",
        "bodyParameters": {
          "parameters": [
            { "name": "from", "value": "={{ $json.mailPayload.from }}" },
            { "name": "to", "value": "={{ $json.mailPayload.to }}" },
            { "name": "subject", "value": "={{ $json.mailPayload.subject }}" },
            { "name": "text", "value": "={{ $json.mailPayload.text }}" }
          ]
        },
        "options": {}
      },
      "id": "send-followup",
      "name": "Send Follow-up Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2750, 200]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  ...$json,\n  campaignStatus: 'follow_up_sent',\n  lastContactedAt: new Date().toISOString()\n}];"
      },
      "id": "record-followup",
      "name": "Record Follow-up",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3000, 200]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  ...$json,\n  campaignStatus: 'completed_followups',\n  lastContactedAt: new Date().toISOString()\n}];"
      },
      "id": "archive-lead",
      "name": "Archive (Max Follow-ups)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2500, 500]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  ...$json,\n  campaignStatus: 'replied',\n  lastContactedAt: new Date().toISOString()\n}];"
      },
      "id": "mark-replied",
      "name": "Mark as Replied",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2750, 500]
    }
  ],
  "connections": {
    "Outreach Webhook Trigger": {
      "main": [[{ "node": "Fetch Lead Details", "type": "main", "index": 0 }]]
    },
    "Fetch Lead Details": {
      "main": [[{ "node": "Prepare Outreach Config", "type": "main", "index": 0 }]]
    },
    "Prepare Outreach Config": {
      "main": [[{ "node": "Build Email Payload", "type": "main", "index": 0 }]]
    },
    "Build Email Payload": {
      "main": [[{ "node": "Send Email via SMTP", "type": "main", "index": 0 }]]
    },
    "Send Email via SMTP": {
      "main": [[{ "node": "Record Email Sent", "type": "main", "index": 0 }]]
    },
    "Record Email Sent": {
      "main": [[{ "node": "Update PB (Email Sent)", "type": "main", "index": 0 }]]
    },
    "Update PB (Email Sent)": {
      "main": [[{ "node": "Wait 3 Days", "type": "main", "index": 0 }]]
    },
    "Wait 3 Days": {
      "main": [[{ "node": "Check for Reply", "type": "main", "index": 0 }]]
    },
    "Check for Reply": {
      "main": [[{ "node": "Send Follow-up?", "type": "main", "index": 0 }]]
    },
    "Send Follow-up?": {
      "main": [
        [{ "node": "Build Follow-up Email", "type": "main", "index": 0 }],
        [{ "node": "Mark as Replied", "type": "main", "index": 0 }]
      ]
    },
    "Build Follow-up Email": {
      "main": [[{ "node": "Send Follow-up Email", "type": "main", "index": 0 }]]
    },
    "Send Follow-up Email": {
      "main": [[{ "node": "Record Follow-up", "type": "main", "index": 0 }]]
    },
    "Record Follow-up": {
      "main": [[{ "node": "Archive (Max Follow-ups)", "type": "main", "index": 0 }]]
    }
  }
}
