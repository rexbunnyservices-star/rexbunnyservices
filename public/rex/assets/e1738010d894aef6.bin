      const knownCurrenciesWithCodeAsSymbol = ["CHF","PLN","SEK","NOK","DKK","CZK","HUF","RON","HRK","BGN","ISK","MDL","BYN","KZT","AMD","UZS","TJS","KGS","MNT","GEL","AFN","MRU","RWF","XAF","XOF","XPF"]; 
      // Initialize default currency variables
      let defaultCountry = '';
