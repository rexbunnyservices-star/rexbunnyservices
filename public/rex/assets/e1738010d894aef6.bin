	<div id="main" data-framer-hydrate-v2="{&quot;routeId&quot;:&quot;ReMCTXikx&quot;,&quot;localeId&quot;:&quot;default&quot;,&quot;breakpoints&quot;:[{&quot;hash&quot;:&quot;s5m9cu&quot;,&quot;mediaQuery&quot;:&quot;(min-width: 1200px)&quot;},{&quot;hash&quot;:&quot;121idx7&quot;,&quot;mediaQuery&quot;:&quot;(min-width: 810px) and (max-width: 1199.98px)&quot;},{&quot;hash&quot;:&quot;7eua5s&quot;,&quot;mediaQuery&quot;:&quot;(max-width: 809.98px)&quot;},{&quot;hash&quot;:&quot;zprce9&quot;,&quot;mediaQuery&quot;:&quot;(min-width: 1200px)&quot;},{&quot;hash&quot;:&quot;nh9cw7&quot;,&quot;mediaQuery&quot;:&quot;(min-width: 810px) and (max-width: 1199.98px)&quot;},{&quot;hash&quot;:&quot;sv03hi&quot;,&quot;mediaQuery&quot;:&quot;(max-width: 809.98px)&quot;}]}" data-framer-ssr-released-at="2026-11-23T13:07:51.203Z" data-framer-page-optimized-at="2026-11-23T15:24:31.773Z" data-framer-generated-page><!--$--><!--$--><style data-framer-html-style>:root body { background: var(--token-958e2cd1-b113-4aa3-9235-7a2b959c8feb, rgb(0, 0, 0)); }</style><div class="framer-nwUvx framer-Z7wAf framer-zprce9" data-layout-template="true" data-selection="true" style="--1moyfq9:64px 0px 0px 0px;--1r5dcfs:var(--overflow-clip-fallback, clip);--u410qi:var(--token-958e2cd1-b113-4aa3-9235-7a2b959c8feb, rgb(0, 0, 0));min-height:100vh;width:auto"><div class="framer-1w39556-container"><div class="ssr-variant hidden-sv03hi"><nav g0kaajzf9="Sign up" mmukwgfsk="rgb(0, 0, 0)" class="framer-AhlFS framer-140pdlc framer-v-140pdlc" data-framer-name="Desktop Nav" data-hide-scrollbars="true" style="background-color:rgba(0, 0, 0, 0);width:100%"><div class="framer-mhxkvs" data-framer-name="Wrapper"><div class="framer-z96yy7" data-framer-name="Logo + CTA" style="background-color:rgba(0, 0, 0, 0)"><div class="framer-fzxmln"><div class="framer-1e61pkd-container" style="opacity:1"><!--$--><!--$--><a class="framer-BHj2t framer-qdeek2 framer-v-qdeek2 framer-4n26gx" data-framer-name="On" data-highlight="true" href="./